<h1>
💳 Payment Management
</h1>


<div class="dashboard-card">


<h3>
Record Payment
</h3>


<form method="POST"
action="/admin/payments">


<label>
Invoice
</label>


<select
name="invoice_id"
required
>

<option value="">
Select Invoice
</option>


<% invoices
    .filter(invoice => Number(invoice.balance) > 0)
    .forEach(invoice => {
%>


<option value="<%= invoice.id %>">

<%= invoice.invoice_number %>

 -

<%= invoice.first_name %>
<%= invoice.last_name %>

 -

<%= invoice.description %>

 -

R<%= Number(invoice.balance || 0).toFixed(2) %>
outstanding

</option>


<%
});
%>


</select>



<label>
Amount
</label>


<input

type="number"

name="amount_paid"

placeholder="Amount"

step="0.01"

min="0.01"

required

>



<label>
Payment Method
</label>


<select
name="payment_method"
required
>

<option value="">
Select Method
</option>

<option value="Cash">
Cash
</option>

<option value="EFT">
EFT
</option>

<option value="Card">
Card
</option>

<option value="Other">
Other
</option>

</select>



<label>
Reference
</label>


<input

name="reference_number"

placeholder="Reference / Transaction Number"

>



<button type="submit">

Record Payment

</button>


</form>


</div>



<h2>
Existing Payments
</h2>


<div class="dashboard-card">


<table class="admin-table">


<thead>

<tr>

<th>
Invoice
</th>

<th>
Student
</th>

<th>
Amount
</th>

<th>
Method
</th>

<th>
Reference
</th>

<th>
Date
</th>

</tr>

</thead>


<tbody>


<% payments.forEach(payment => { %>


<tr>

<td>
<%= payment.invoice_number %>
</td>


<td>
<%= payment.first_name %>
<%= payment.last_name %>
</td>


<td>
R<%= Number(payment.amount_paid || 0).toFixed(2) %>
</td>


<td>
<%= payment.payment_method || "-" %>
</td>


<td>
<%= payment.reference_number || "-" %>
</td>


<td>
<%= payment.payment_date || payment.created_at %>
</td>


</tr>


<% }) %>


</tbody>


</table>


</div>