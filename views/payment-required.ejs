<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Payment Required - MathMaster</title>

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>

<a href="/student/finance">
Finance
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>

<main class="dashboard">

<div class="dashboard-header">

<p class="eyebrow">
ACCOUNT NOTICE
</p>

<h1>
💳 Payment Required
</h1>

<p>
Your learning access is temporarily restricted because
your account has an outstanding balance.
</p>

</div>

<div class="dashboard-card">

<h2>
Outstanding Balance
</h2>

<h1>
R<%= Number(totalBalance || 0).toFixed(2) %>
</h1>

<p>
Please review your finance account for details about
your outstanding fees and payments.
</p>

<div style="margin-top: 24px;">

<a href="/student/finance" class="btn">
View My Finance
</a>

<a href="/student/dashboard" class="btn">
Return to Dashboard
</a>

</div>

</div>

</main>

</body>

</html>
