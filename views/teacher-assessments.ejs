<!DOCTYPE html>
<html>

<head>

<title>
Teacher Assessments
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<div class="container">


<h1>
📋 My Assessments
</h1>


<p>
Manage your created assessments.
</p>



<% assessments.forEach(a => { %>


<div class="stat-card">


<div>


<h2>
<%= a.title %>
</h2>


<p>
Course:
<%= a.course_title %>
</p>


<p>
Lesson:
<%= a.lesson_title %>
</p>


<p>
Total Marks:
<%= a.total_marks %>
</p>


<div class="assessment-actions">

    <a
        class="btn btn-primary"
        href="/teacher/assessments/<%= a.id %>/questions">

        📝 Manage Questions

    </a>


    <a
        class="btn btn-success"
        href="/teacher/assessments/<%= a.id %>/results">

        📊 View Results

    </a>


    <a
        class="btn btn-warning"
        href="/teacher/assessments/<%= a.id %>/edit">

        ✏ Edit Assessment

    </a>


    <form
    action="/teacher/assessments/<%= a.id %>/delete"
    method="POST"
    onsubmit="return confirm('Delete this assessment and all its questions and results?');">

    <button class="btn btn-danger">

        🗑 Delete Assessment

    </button>

</form>

</div>


</div>


</div>


<% }) %>


</div>


</body>

</html>