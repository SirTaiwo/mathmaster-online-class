<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>
Exercise
</title>

<link rel="stylesheet"
      href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>


<a href="/student/my-courses">
My Courses
</a>


<a href="/logout">
Logout
</a>


</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">


<p class="eyebrow">
MATHEMATICS EXERCISE
</p>


<h1>
<%= exercise.question %>
</h1>


</div>



<div class="dashboard-card">


<form method="POST"
action="/student/exercises/<%= exercise.id %>/submit">


<label>
Your Answer
</label>


<input
type="text"
name="answer"
placeholder="Enter your answer"
required
>


<button
class="btn primary"
type="submit">

Submit Answer

</button>


</form>



<hr>

<h3>
📊 My Attempts
</h3>


<% if (submissions && submissions.length > 0) { %>

<div style="overflow-x: auto;">

<table class="admin-table">

<thead>

<tr>

<th>
Date
</th>

<th>
Your Answer
</th>

<th>
Result
</th>

<th>
Marks
</th>

</tr>

</thead>


<tbody>

<% submissions.forEach(function(submission) { %>

<tr>

<td>
<%= submission.created_at %>
</td>


<td>
<%= submission.answer %>
</td>


<td>

<% if (submission.correct) { %>

<span>
✅ Correct
</span>

<% } else { %>

<span>
❌ Incorrect
</span>

<% } %>

</td>


<td>
<%= submission.marks %>
</td>

</tr>

<% }) %>

</tbody>

</table>

</div>

<% } else { %>

<p>
You have not attempted this exercise yet.
</p>

<% } %>



<!-- ========================================
     RECORD YOUR WORK
========================================= -->

<hr>

<h3>
🎙️ Record Your Work
</h3>

<p>
You can record an audio or video explanation of your answer.
</p>

<div style="display: flex; gap: 10px; flex-wrap: wrap;">

<button
    type="button"
    class="btn primary"
    id="startAudioBtn">

    🎙️ Start Audio Recording

</button>


<button
    type="button"
    class="btn primary"
    id="startVideoBtn">

    🎥 Start Video Recording

</button>


<button
    type="button"
    class="btn"
    id="stopRecordingBtn"
    disabled>

    ⏹️ Stop Recording

</button>

</div>


<div
    id="recordingStatus"
    style="margin-top: 15px;">

    Ready to record.

</div>


<div
    id="videoPreviewContainer"
    style="display: none; margin-top: 20px;">

    <video
        id="videoPreview"
        controls
        style="max-width: 100%; width: 500px;">
    </video>

</div>


<div
    id="audioPreviewContainer"
    style="display: none; margin-top: 20px;">

    <audio
        id="audioPreview"
        controls>
    </audio>

</div>


<button
    type="button"
    class="btn primary"
    id="uploadRecordingBtn"
    style="display: none; margin-top: 15px;">

    ⬆️ Upload Recording

</button>


<div
    id="uploadStatus"
    style="margin-top: 10px;">
</div>

<!-- ========================================
     SAVED RECORDINGS
========================================= -->

<hr>

<h3>
📁 My Saved Recordings
</h3>

<% if (recordings && recordings.length > 0) { %>

    <% recordings.forEach(function(recording) { %>

        <div
            class="dashboard-card"
            style="margin-top: 15px;">

            <p>
                <strong>
                    <%= recording.media_type === "video"
                        ? "🎥 Video Recording"
                        : "🎙️ Audio Recording" %>
                </strong>
            </p>

            <p>
                Recorded:
                <%= recording.created_at %>
            </p>

            <% if (recording.media_type === "video") { %>

                <video
                    controls
                    preload="metadata"
                    style="max-width: 100%; width: 500px;">

                    <source
                        src="<%= recording.file_path %>"
                        type="<%= recording.mime_type %>">

                    Your browser does not support video playback.

                </video>

            <% } else { %>

                <audio
                    controls
                    preload="metadata"
                    style="width: 100%;">

                    <source
                        src="<%= recording.file_path %>"
                        type="<%= recording.mime_type %>">

                    Your browser does not support audio playback.

                </audio>

            <% } %>

        </div>

    <% }) %>

<% } else { %>

    <p>
        You have not saved any audio or video recordings for this exercise yet.
    </p>

<% } %>


</div>


</main>


<script>

let mediaRecorder = null;
let mediaStream = null;
let recordedChunks = [];
let recordedBlob = null;
let recordingType = null;


const startAudioBtn =
    document.getElementById("startAudioBtn");

const startVideoBtn =
    document.getElementById("startVideoBtn");

const stopRecordingBtn =
    document.getElementById("stopRecordingBtn");

const uploadRecordingBtn =
    document.getElementById("uploadRecordingBtn");

const recordingStatus =
    document.getElementById("recordingStatus");

const uploadStatus =
    document.getElementById("uploadStatus");

const audioPreview =
    document.getElementById("audioPreview");

const videoPreview =
    document.getElementById("videoPreview");


// ========================================
// START RECORDING
// ========================================

async function startRecording(type) {

    try {

        recordingType = type;

        const constraints =
            type === "video"
                ? {
                    audio: true,
                    video: true
                }
                : {
                    audio: true
                };


        mediaStream =
            await navigator.mediaDevices
                .getUserMedia(constraints);


        recordedChunks = [];

        recordedBlob = null;


       const supportedMimeTypes =
    type === "video"
        ? [
            "video/webm;codecs=vp8,opus",
            "video/webm;codecs=vp9,opus",
            "video/webm"
        ]
        : [
            "audio/webm;codecs=opus",
            "audio/webm"
        ];


const mimeType =
    supportedMimeTypes.find(
        type =>
            MediaRecorder.isTypeSupported(type)
    );


if (!mimeType) {

    recordingStatus.textContent =
        `Your browser does not support recording ${type} in a compatible format.`;

    mediaStream
        .getTracks()
        .forEach(
            track =>
                track.stop()
        );

    return;

}


        mediaRecorder =
            new MediaRecorder(
                mediaStream,
                {
                    mimeType
                }
            );


        mediaRecorder.ondataavailable =
            function(event) {

                if (event.data.size > 0) {

                    recordedChunks.push(
                        event.data
                    );

                }

            };


        mediaRecorder.onstop =
            function() {

                recordedBlob =
                    new Blob(
                        recordedChunks,
                        {
                            type: mimeType
                        }
                    );


                const previewUrl =
                    URL.createObjectURL(
                        recordedBlob
                    );


                if (recordingType === "video") {

                    videoPreview.src =
                        previewUrl;

                    videoPreview.style.display =
                        "block";

                    audioPreview.style.display =
                        "none";

                } else {

                    audioPreview.src =
                        previewUrl;

                    audioPreview.style.display =
                        "block";

                    videoPreview.style.display =
                        "none";

                }


                uploadRecordingBtn.style.display =
                    "inline-block";


                recordingStatus.textContent =
                    "Recording finished. You can preview it before uploading.";


                if (mediaStream) {

                    mediaStream
                        .getTracks()
                        .forEach(
                            track =>
                                track.stop()
                        );

                }

            };


        mediaRecorder.start();


        startAudioBtn.disabled = true;
        startVideoBtn.disabled = true;
        stopRecordingBtn.disabled = false;
        uploadRecordingBtn.style.display = "none";


        recordingStatus.textContent =
            type === "video"
                ? "🎥 Video recording in progress..."
                : "🎤 Audio recording in progress...";

    }

    catch (error) {

        console.error(error);

        recordingStatus.textContent =
            "Unable to access your microphone or camera. Please check your browser permissions.";

    }

}


// ========================================
// STOP RECORDING
// ========================================

function stopRecording() {

    if (
        mediaRecorder &&
        mediaRecorder.state !== "inactive"
    ) {

        mediaRecorder.stop();

    }


    startAudioBtn.disabled = false;
    startVideoBtn.disabled = false;
    stopRecordingBtn.disabled = true;

}


// ========================================
// UPLOAD RECORDING
// ========================================

async function uploadRecording() {

    if (!recordedBlob) {

        uploadStatus.textContent =
            "There is no recording to upload.";

        return;

    }

    const formData =
        new FormData();


    const extension =
        recordingType === "video"
            ? "webm"
            : "webm";
formData.append(
    "recordingType",
    recordingType
);

    formData.append(
        "recording",
        recordedBlob,
        `exercise-${<%= exercise.id %>}-${Date.now()}.${extension}`
    );


    uploadStatus.textContent =
        "Uploading recording...";


    uploadRecordingBtn.disabled = true;


    try {

        const response =
            await fetch(
                "/student/exercises/<%= exercise.id %>/recording",
                {
                    method: "POST",
                    body: formData
                }
            );


        const data =
            await response.json();


        if (!response.ok || !data.success) {

            throw new Error(
                data.message ||
                "Recording upload failed."
            );

        }


        uploadStatus.textContent =
            "✅ Recording uploaded successfully.";


        uploadRecordingBtn.disabled =
            false;

    }

    catch (error) {

        console.error(error);

        uploadStatus.textContent =
            "❌ " + error.message;

        uploadRecordingBtn.disabled =
            false;

    }

}


// ========================================
// BUTTON EVENTS
// ========================================

startAudioBtn.addEventListener(
    "click",
    function() {

        startRecording("audio");

    }
);


startVideoBtn.addEventListener(
    "click",
    function() {

        startRecording("video");

    }
);


stopRecordingBtn.addEventListener(
    "click",
    stopRecording
);


uploadRecordingBtn.addEventListener(
    "click",
    uploadRecording
);

</script>


</body>

</html>