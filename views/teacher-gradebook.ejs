<!DOCTYPE html>

<html>

<head>

<title>
Teacher Gradebook
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/dashboard">
Dashboard
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
GRADEBOOK
</p>

<h1>
Student Performance
</h1>


</div>

<!-- ========================================
     GRADEBOOK SUMMARY
========================================= -->

<div class="dashboard-grid" style="margin-top: 25px;">


<div class="dashboard-card">

<p class="eyebrow">
TOTAL ATTEMPTS
</p>

<h2>
<%= summary.total_attempts || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
CORRECT ANSWERS
</p>

<h2>
<%= summary.correct_answers || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
INCORRECT ANSWERS
</p>

<h2>
<%= summary.incorrect_answers || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
TOTAL MARKS
</p>

<h2>
<%= summary.total_marks || 0 %>
</h2>

</div>

<div class="dashboard-card">

<h3>
OVERALL SCORE
</h3>

<h2>
<%= scorePercentage %>%
</h2>

</div>

</div>




<div class="dashboard-card">

     <!-- ========================================
     STUDENT GRADEBOOK SUMMARY
========================================= -->


<div class="dashboard-card" style="margin-top: 25px;">

<h2>
Student Gradebook Summary
</h2>


<table>

<thead>

<tr>

<th>
Student
</th>

<th>
Attempts
</th>

<th>
Correct
</th>

<th>
Incorrect
</th>

<th>
Marks
</th>

<th>
Score
</th>

</tr>

</thead>


<tbody>

<% studentSummaries.forEach(function(student){ %>

<tr>

<td>
<%= student.first_name %>
<%= student.last_name %>
</td>

<td>
<%= student.total_attempts %>
</td>

<td>
<%= student.correct_answers %>
</td>

<td>
<%= student.incorrect_answers %>
</td>

<td>
<%= student.total_marks %>
/
<%= student.total_possible_marks %>
</td>

<td>

<%= student.total_possible_marks > 0
    ? Math.round(
        (student.total_marks /
        student.total_possible_marks) * 100
      )
    : 0
%>%

</td>

</tr>

<% }); %>

</tbody>

</table>

</div>


<!-- ========================================
     EXERCISE ANALYTICS
========================================= -->

<div class="dashboard-grid" style="margin-top: 25px;">

<div class="dashboard-card">

<p class="eyebrow">
TOTAL EXERCISES
</p>

<h2>
<%= exerciseAnalytics.total_exercises || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
AVERAGE SCORE
</p>

<h2>
<%= exerciseAnalytics.average_score || 0 %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
HIGHEST SCORE
</p>

<h2>
<%= exerciseAnalytics.highest_score || 0 %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
LOWEST SCORE
</p>

<h2>
<%= exerciseAnalytics.lowest_score || 0 %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
PASSING EXERCISES
</p>

<h2>
<%= exerciseAnalytics.passing_exercises || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
NEEDS SUPPORT
</p>

<h2>
<%= exerciseAnalytics.exercises_needing_support || 0 %>
</h2>

</div>

</div>


<!-- ========================================
     EXERCISE PERFORMANCE
========================================= -->

<div class="dashboard-card" style="margin-top: 25px;">

<h2>
Exercise Performance
</h2>

<table>

<thead>

<tr>

<th>Exercise</th>
<th>Attempts</th>
<th>Correct</th>
<th>Incorrect</th>
<th>Marks</th>
<th>Score</th>

</tr>

</thead>

<tbody>

<% exercisePerformance.forEach(function(exercise){ %>

<tr>

<td>
<%= exercise.question %>
</td>

<td>
<%= exercise.attempts %>
</td>

<td>
<%= exercise.correct_answers %>
</td>

<td>
<%= exercise.incorrect_answers %>
</td>

<td>
<%= exercise.total_marks %>
/
<%= exercise.total_possible_marks %>
</td>

<td>
<%= exercise.total_possible_marks > 0
    ? Math.round(
        (exercise.total_marks /
         exercise.total_possible_marks) * 100
      )
    : 0
%>%
</td>

</tr>

<% }); %>

</tbody>

</table>

</div>


<table>

<tr>

<th>
Student
</th>

<th>
Exercise
</th>

<th>
Answer
</th>

<th>
Status
</th>

<th>
Marks
</th>

</tr>



<% submissions.forEach(function(item){ %>


<tr>


<td>

<%= item.first_name %>
<%= item.last_name %>

</td>


<td>

<%= item.question %>

</td>


<td>

<%= item.answer %>

</td>


<td>

<%= item.correct ? "✅ Correct" : "❌ Incorrect" %>

</td>


<td>

<%= item.marks %>

</td>


</tr>


<% }) %>


</table>


</div>


</main>


</body>

</html>