<!DOCTYPE html>

<html>

<head>

<title>
Teacher Gradebook
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/dashboard">
Dashboard
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
GRADEBOOK
</p>

<h1>
Student Performance
</h1>


</div>

<!-- ========================================
     GRADEBOOK SUMMARY
========================================= -->

<div class="dashboard-grid" style="margin-top: 25px;">


<div class="dashboard-card">

<p class="eyebrow">
TOTAL ATTEMPTS
</p>

<h2>
<%= summary.total_attempts || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
CORRECT ANSWERS
</p>

<h2>
<%= summary.correct_answers || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
INCORRECT ANSWERS
</p>

<h2>
<%= summary.incorrect_answers || 0 %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
TOTAL MARKS
</p>

<h2>
<%= summary.total_marks || 0 %>
</h2>

</div>

<div class="dashboard-card">

<h3>
OVERALL SCORE
</h3>

<h2>
<%= scorePercentage %>%
</h2>

</div>

</div>




<div class="dashboard-card">


<table>


<tr>

<th>
Student
</th>

<th>
Exercise
</th>

<th>
Answer
</th>

<th>
Status
</th>

<th>
Marks
</th>

</tr>



<% submissions.forEach(function(item){ %>


<tr>


<td>

<%= item.first_name %>
<%= item.last_name %>

</td>


<td>

<%= item.question %>

</td>


<td>

<%= item.answer %>

</td>


<td>

<%= item.correct ? "✅ Correct" : "❌ Incorrect" %>

</td>


<td>

<%= item.marks %>

</td>


</tr>


<% }) %>


</table>


</div>


</main>


</body>

</html>