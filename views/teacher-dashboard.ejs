<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Teacher Dashboard</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>

<header>

    <nav class="navbar">

        <div class="logo">
            Math<span>Master</span>
        </div>

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>

</header>


<main class="dashboard">

    <div class="dashboard-header">

        <p class="eyebrow">
            TEACHER DASHBOARD
        </p>

        <h1>
            Welcome,
            <%= user.first_name %>!
        </h1>

        <p>
            Role:
            <strong>
                <%= user.role %>
            </strong>
        </p>

    </div>


    <div class="dashboard-card">

    <h3>
        📚 Classes
    </h3>

    <h2>
        <%= stats.classes %>
    </h2>

    <p>
        Manage your mathematics classes.
    </p>

</div>


<div class="dashboard-card">

<h3>
👨‍🎓 Students
</h3>

<h2>
<%= stats.students %>
</h2>

<p>
View students assigned to you.
</p>

<a
href="/teacher/students"
class="btn primary">

View Students

</a>

</div>

<div class="dashboard-card">

    <h3>
        📝 Assignments
    </h3>

    <h2>
        <%= stats.assignments %>
    </h2>

    <p>
        Create and manage assignments.
    </p>

</div>


<div class="dashboard-card">

    <h3>
        📊 Assessments
    </h3>

    <h2>
        <%= stats.assessments %>
    </h2>

    <p>
        Monitor learner performance.
    </p>

</div>

        <div class="dashboard-card">

    <h3>
        📚 Courses
    </h3>

    <p>
        Create and manage mathematics courses.
    </p>


    <a 
    href="/teacher/courses"
    class="btn primary">

        Manage Courses

    </a>
    <a href="/teacher/assessment-gradebook" class="btn primary">

    📊 Assessment Gradebook

</a>

</div>


        <div class="dashboard-card">

            <h3>
                📝 Lessons
            </h3>

            <p>
                Create lessons and learning materials.
            </p>

        </div>


        <div class="dashboard-card">

            <h3>
                📊 Student Results
            </h3>

            <p>
                Monitor student performance and progress.
            </p>

        </div>
        <div class="dashboard-card">

    <h3>
        📋 My Assessments
    </h3>


    <p>
        Create, edit and manage assessments.
    </p>


    <a href="/teacher/assessments">

        Open Assessments

    </a>


</div>
<section class="dashboard-section">

    <h2>
        📊 Teacher Analytics
    </h2>

    <div class="dashboard-card">

<h3>
✅ Pass Rate
</h3>

<h2>
<%= passRate.pass_rate || 0 %>%
</h2>

<p>
Students passing assessments
</p>

</div>
<section>

<h2>
📊 Performance Distribution
</h2>


<div class="dashboard-grid">


<div class="dashboard-card">

<h3>
🌟 Excellent
</h3>

<h2>
<%= distribution.excellent %>
</h2>

</div>



<div class="dashboard-card">

<h3>
👍 Good
</h3>

<h2>
<%= distribution.good %>
</h2>

</div>



<div class="dashboard-card">

<h3>
📘 Satisfactory
</h3>

<h2>
<%= distribution.satisfactory %>
</h2>

</div>



<div class="dashboard-card">

<h3>
⚠️ Needs Support
</h3>

<h2>
<%= distribution.support %>
</h2>

</div>


</div>

</section>

<section>

<h2>
🏆 Top Students
</h2>


<% topStudents.forEach(student => { %>


<div class="dashboard-card">


<h3>
👨‍🎓
<%= student.first_name %>
<%= student.last_name %>
</h3>


<p>
Average Score:

<strong>
<%= student.average_score %>%
</strong>

</p>


</div>


<% }) %>


</section>

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                📝
            </div>

            <div>

                <p>
                    Total Attempts
                </p>

                <h2>
                    <%= analytics.total_attempts %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                📈
            </div>

            <div>

                <p>
                    Average Score
                </p>

                <h2>
                    <%= analytics.average_score %>%
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                🏆
            </div>

            <div>

                <p>
                    Highest Score
                </p>

                <h2>
                    <%= analytics.highest_score %>%
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                ✅
            </div>

            <div>

                <p>
                    Passed
                </p>

                <h2>
                    <%= analytics.passed %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                ❌
            </div>

            <div>

                <p>
                    Failed
                </p>

                <h2>
                    <%= analytics.failed %>
                </h2>

            </div>

        </div>

    </div>

</section>

    </div>

    <section>

<h2>
📊 Performance Chart
</h2>


<div class="dashboard-card">

<canvas id="performanceChart"></canvas>

</div>


</section>

<section>

<h2>
📈 Student Progress Trend
</h2>


<div class="dashboard-card">

<canvas id="progressChart"></canvas>

</div>


</section>
</main>

<script>

const progressCtx =
document.getElementById(
    "progressChart"
);


new Chart(progressCtx, {

    type: "line",


    data: {


        labels: [

            <% progressTrend.forEach((item, index) => { %>

                "Attempt <%= index + 1 %>",

            <% }) %>

        ],


        datasets: [{

            label: "Percentage",


            data: [

                <% progressTrend.forEach(item => { %>

                    <%= item.percentage %>,

                <% }) %>

            ],


            tension: 0.3

        }]


    },


    options: {

        scales: {

            y: {

                beginAtZero: true,

                max: 100

            }

        }

    }


});

</script>

<script>

const ctx =
document.getElementById(
    "performanceChart"
);


new Chart(ctx, {

    type: "doughnut",

    data: {

        labels: [

            "Excellent",

            "Good",

            "Satisfactory",

            "Needs Support"

        ],


        datasets: [{

            data: [

                <%= distribution.excellent %>,

                <%= distribution.good %>,

                <%= distribution.satisfactory %>,

                <%= distribution.support %>

            ]

        }]

    }

});

</script>

</body>

</html>