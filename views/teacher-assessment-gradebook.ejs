                    data: [

                        <% assessmentPerformance.forEach(item => { %>

                            <%= item.average_score %>,

                        <% }) %>

                    ]

                },

                {

                    label:
                        "Highest Score",

                    data: [

                        <% assessmentPerformance.forEach(item => { %>

                            <%= item.highest_score %>,

                        <% }) %>

                    ]

                },

                {

                    label:
                        "Lowest Score",

                    data: [

                        <% assessmentPerformance.forEach(item => { %>

                            <%= item.lowest_score %>,

                        <% }) %>

                    ]

                },

                {

                    label:
                        "Pass Benchmark (50%)",

                    data: [

                        <% assessmentPerformance.forEach(() => { %>

                            50,

                        <% }) %>

                    ],

                    type: "line",

                    borderDash: [6, 6],

                    pointRadius: 0,

                    borderWidth: 2

                }

            ]


        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            scales: {

                y: {

                    beginAtZero: true,

                    max: 100,

                    ticks: {

                        callback:
                            function(value) {

                                return value + "%";

                            }

                    }

                }

            },

            plugins: {

                legend: {

                    display: true

                }

            }

        }

    }

);

<% } %>

</script>


