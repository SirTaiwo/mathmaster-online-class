<!DOCTYPE html>
<html>

<head>

<title>
Geometry Workspace
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/math-tools">
Math Tools
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<h1>
📐 Geometry Workspace
</h1>

<p>
Interactive construction tools for mathematics lessons.
</p>

</div>



<div class="dashboard-card">


<h2>
⭕ Compass Tool
</h2>


<p>
Select a radius and draw a circle.
</p>


<label>
Radius:
</label>


<input 
type="number"
id="radius"
value="50"
min="10"
max="200"
>



<button 
onclick="drawCircle()"
class="btn primary">

Draw Circle

</button>


<button 
onclick="clearCanvas()"
class="btn">

Clear

</button>


<br><br>


<canvas
id="geometryCanvas"
width="500"
height="400"
style="border:1px solid black;">
</canvas>


</div>

<div class="dashboard-card">


<h2>
📏 Ruler Tool
</h2>


<p>
Measure the distance between two points.
</p>


<button
onclick="drawRuler()"
class="btn primary">

Draw Ruler

</button>


<p id="distanceResult">

Distance:

</p>


</div>

<div class="dashboard-card">


<h2>
📐 Protractor Tool
</h2>


<p>
Measure angles between two lines.
</p>


<button
onclick="drawAngle()"
class="btn primary">

Create Angle

</button>


<p id="angleResult">

Angle:

</p>


</div>

</div>



</main>



<script>

const canvas =
document.getElementById(
"geometryCanvas"
);


const ctx =
canvas.getContext("2d");



function drawCircle(){

    clearCanvas();


    const radius =
    document.getElementById(
        "radius"
    ).value;


    ctx.beginPath();


    ctx.arc(
        250,
        200,
        radius,
        0,
        Math.PI * 2
    );


    ctx.stroke();


}



function clearCanvas(){

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

}

let pointA = {
    x:100,
    y:200
};


let pointB = {
    x:400,
    y:200
};


let draggingPoint = null;



function drawRuler(){

    clearCanvas();


    // Draw line

    ctx.beginPath();

    ctx.moveTo(
        pointA.x,
        pointA.y
    );

    ctx.lineTo(
        pointB.x,
        pointB.y
    );

    ctx.stroke();



    // Draw points

    ctx.beginPath();

    ctx.arc(
        pointA.x,
        pointA.y,
        8,
        0,
        Math.PI * 2
    );


    ctx.arc(
        pointB.x,
        pointB.y,
        8,
        0,
        Math.PI * 2
    );


    ctx.fill();



    // Calculate distance

    const distance =
    Math.sqrt(

        Math.pow(
            pointB.x - pointA.x,
            2
        )

        +

        Math.pow(
            pointB.y - pointA.y,
            2
        )

    );


    document.getElementById(
        "distanceResult"
    ).innerHTML =

    "Distance: "
    +
    distance.toFixed(2)
    +
    " pixels";

}


// Initial drawing

drawRuler();



// Mouse down

canvas.addEventListener(
"mousedown",
function(event){


    const rect =
    canvas.getBoundingClientRect();


    const mouseX =
    event.clientX - rect.left;


    const mouseY =
    event.clientY - rect.top;



    if(
        Math.hypot(
            mouseX - pointA.x,
            mouseY - pointA.y
        )
        < 15
    ){

        draggingPoint = "A";

    }


    else if(

        Math.hypot(
            mouseX - pointB.x,
            mouseY - pointB.y
        )
        < 15

    ){

        draggingPoint = "B";

    }


});

let vertex = {
    x:250,
    y:200
};


let armA = {
    x:120,
    y:300
};


let armB = {
    x:400,
    y:100
};


let draggingAnglePoint = null;



function drawAngle(){

    clearCanvas();



    // Draw first arm

    ctx.beginPath();

    ctx.moveTo(
        vertex.x,
        vertex.y
    );

    ctx.lineTo(
        armA.x,
        armA.y
    );

    ctx.stroke();



    // Draw second arm

    ctx.beginPath();

    ctx.moveTo(
        vertex.x,
        vertex.y
    );

    ctx.lineTo(
        armB.x,
        armB.y
    );

    ctx.stroke();



    // Draw points

    [armA, armB, vertex].forEach(point => {

        ctx.beginPath();

        ctx.arc(
            point.x,
            point.y,
            8,
            0,
            Math.PI * 2
        );

        ctx.fill();

    });



    // Calculate angle

    const angle1 =
    Math.atan2(
        armA.y - vertex.y,
        armA.x - vertex.x
    );


    const angle2 =
    Math.atan2(
        armB.y - vertex.y,
        armB.x - vertex.x
    );


    let degrees =
    Math.abs(
        (angle2 - angle1)
        *
        180
        /
        Math.PI
    );


    if(degrees > 180){

        degrees =
        360 - degrees;

    }



    document.getElementById(
        "angleResult"
    ).innerHTML =

    "Angle: "
    +
    degrees.toFixed(1)
    +
    "°";

}

canvas.addEventListener(
"mousedown",
function(event){

    const rect =
    canvas.getBoundingClientRect();


    const x =
    event.clientX - rect.left;


    const y =
    event.clientY - rect.top;



    if(
        Math.hypot(
            x - armA.x,
            y - armA.y
        ) < 15
    ){

        draggingAnglePoint = "A";

    }


    else if(
        Math.hypot(
            x - armB.x,
            y - armB.y
        ) < 15
    ){

        draggingAnglePoint = "B";

    }


});

canvas.addEventListener(
"mousemove",
function(event){

    if(!draggingAnglePoint)
        return;


    const rect =
    canvas.getBoundingClientRect();


    const x =
    event.clientX - rect.left;


    const y =
    event.clientY - rect.top;



    if(draggingAnglePoint === "A"){

        armA.x = x;
        armA.y = y;

    }


    if(draggingAnglePoint === "B"){

        armB.x = x;
        armB.y = y;

    }


    drawAngle();

});

canvas.addEventListener(
"mouseup",
function(){

    draggingAnglePoint = null;

});


// Mouse move

canvas.addEventListener(
"mousemove",
function(event){


    if(!draggingPoint)
        return;


    const rect =
    canvas.getBoundingClientRect();


    const x =
    event.clientX - rect.left;


    const y =
    event.clientY - rect.top;



    if(draggingPoint === "A"){

        pointA.x = x;
        pointA.y = y;

    }


    if(draggingPoint === "B"){

        pointB.x = x;
        pointB.y = y;

    }


    drawRuler();


});



// Mouse release

canvas.addEventListener(
"mouseup",
function(){

    draggingPoint = null;

});

</script>


</body>

</html>