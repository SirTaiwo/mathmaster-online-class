<!DOCTYPE html>
<html>

<head>

<title>
Student Performance
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/students">
My Students
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>


<main class="dashboard">


<h1>
📈 Student Performance Report
</h1>


<h2>
<%= student.first_name %>
<%= student.last_name %>
</h2>

<div class="dashboard-card">

<h3>
📊 Performance Status
</h3>


<h2>

<%= status.icon %>

<%= status.label %>

</h2>


</div>



<div class="dashboard-grid">


<div class="dashboard-card">

<h3>
📝 Tests Taken
</h3>

<h2>
<%= performance.attempts %>
</h2>

</div>



<div class="dashboard-card">

<h3>
📊 Average Score
</h3>

<h2>
<%= performance.average_percentage %>%
</h2>

</div>



<div class="dashboard-card">

<h3>
🏆 Highest Score
</h3>

<h2>
<%= performance.highest_percentage %>%
</h2>

</div>


</div>



<h2>
Assessment History
</h2>


<% results.forEach(result => { %>


<div class="dashboard-card">

<h3>
<%= result.assessment_title %>
</h3>


<p>
Score:
<%= result.score %> /
<%= result.total_marks %>
</p>


<p>
Percentage:
<%= result.percentage %>%
</p>


<p>
Submitted:
<%= result.submitted_at %>
</p>


</div>


<% }) %>



</main>


</body>

</html>