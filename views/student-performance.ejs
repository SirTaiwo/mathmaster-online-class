<!DOCTYPE html>
<html>

<head>

<title>
Student Performance
</title>

<link rel="stylesheet" href="/css/style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/students">
My Students
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>


<main class="dashboard">


<h1>
📈 Student Performance Report
</h1>


<h2>
<%= student.first_name %>
<%= student.last_name %>
</h2>

<div class="dashboard-card">

<h3>
📊 Performance Status
</h3>


<h2>

<%= status.icon %>

<%= status.label %>

</h2>


</div>



<div class="dashboard-grid">


<div class="dashboard-card">

<h3>
📝 Tests Taken
</h3>

<h2>
<%= performance.attempts %>
</h2>

</div>



<div class="dashboard-card">

<h3>
📊 Average Score
</h3>

<h2>
<%= performance.average_percentage %>%
</h2>

</div>



<div class="dashboard-card">

<h3>
🏆 Highest Score
</h3>

<h2>
<%= performance.highest_percentage %>%
</h2>

</div>

</div>


<div class="dashboard-card" style="margin-top: 25px;">

    <h3>
        <%= insight.icon %>
        <%= insight.title %>
    </h3>

    <p>
        <%= insight.message %>
    </p>

    <% if (insight.latestScore !== null) { %>

        <div class="dashboard-grid" style="margin-top: 20px;">

            <div class="dashboard-card">

                <h4>
                    Latest Score
                </h4>

                <h2>
                    <%= insight.latestScore %>%
                </h2>

            </div>


            <% if (insight.previousScore !== null) { %>

                <div class="dashboard-card">

                    <h4>
                        Previous Score
                    </h4>

                    <h2>
                        <%= insight.previousScore %>%
                    </h2>

                </div>


                <div class="dashboard-card">

                    <h4>
                        Change
                    </h4>

                    <h2>

                        <% if (insight.difference > 0) { %>
                            +<%= insight.difference %>%
                        <% } else { %>
                            <%= insight.difference %>%
                        <% } %>

                    </h2>

                </div>

            <% } %>

        </div>

    <% } %>

</div>


<h2>
📈 Progress Trend
</h2>


<div class="dashboard-card" style="height: 350px;">

<canvas id="studentProgressChart"></canvas>

</div>


<h2>
Assessment History
</h2>


<% results.forEach(result => { %>


<div class="dashboard-card">

<h3>
<%= result.assessment_title %>
</h3>


<p>
Score:
<%= result.score %> /
<%= result.total_marks %>
</p>


<p>
Percentage:
<%= result.percentage %>%
</p>


<p>
Submitted:
<%= result.submitted_at %>
</p>


</div>


<% }) %>

<h2>
👨‍🏫 Teacher Feedback
</h2>


<% if (feedback && feedback.length > 0) { %>

    <h3>
        Previous Feedback
    </h3>

    <% feedback.forEach(item => { %>

        <div class="dashboard-card" style="margin-bottom: 20px;">

            <h3>
                👨‍🏫
                <%= item.teacher_first %>
                <%= item.teacher_last %>
            </h3>

            <p style="color: #666;">

                <%= new Date(
                    item.created_at.replace(" ", "T")
                ).toLocaleString("en-ZA", {
                    day: "2-digit",
                    month: "short",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false
                }) %>

            </p>

            <p style="white-space: pre-line;">

                <%= item.feedback %>

            </p>

        </div>

    <% }) %>

<% } else { %>

    <div class="dashboard-card">

        <p>
            No teacher feedback has been recorded yet.
        </p>

    </div>

<% } %>


<h3>
    Write New Feedback
</h3>


<form

    method="POST"

    action="/teacher/students/<%= student.id %>/feedback"

    class="form-card">


    <label>
        Feedback
    </label>


    <textarea

        name="feedback"

        rows="5"

        placeholder="Write feedback for this student..."

        required></textarea>


    <button

        class="btn primary"

        type="submit">

        Save Feedback

    </button>


</form>

</main>


<script>

const studentProgressData =
    <%- JSON.stringify(trend) %>;


const progressLabels =
    studentProgressData.map(
        item => {

            const date =
                new Date(
                    item.submitted_at.replace(" ", "T")
                );

            const formattedDate =
                date.toLocaleDateString("en-ZA", {
                    day: "2-digit",
                    month: "short"
                });

            const formattedTime =
                date.toLocaleTimeString("en-ZA", {
                    hour: "2-digit",
                    minute: "2-digit",
                    hour12: false
                });

            return item.assessment_title +
                " - " +
                formattedDate +
                " " +
                formattedTime;

        }
    );


const progressValues =
    studentProgressData.map(
        item => item.percentage
    );


new Chart(

    document.getElementById(
        "studentProgressChart"
    ),

    {

        type: "line",

        data: {

            labels:
                progressLabels,

            datasets: [

                {

                    label:
                        "Percentage",

                    data:
                        progressValues,

                    tension:
                        0.3,

                    fill:
                        false

                }

            ]

        },

        options: {

            responsive:
                true,

            maintainAspectRatio:
                false,

            scales: {

                y: {

                    min: 0,

                    max: 100,

                    title: {

                        display: true,

                        text:
                            "Percentage (%)"

                    }

                }

            }

        }

    }

);

</script>

</body>

</html>
