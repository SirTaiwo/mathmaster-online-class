<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Users</title>

    
<link
    rel="stylesheet"
    href="/css/style.css"
>

</head>

<body>


<header>

    <nav class="navbar">

        <div class="logo">
            Math<span>Master</span>
        </div>

        <div class="nav-links">

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>

</header>


<main class="dashboard">


    <div class="dashboard-header">

        <p class="eyebrow">
            ADMINISTRATION
        </p>

        <h1>
            Manage Users
        </h1>

        <p>
            Create and manage teachers and students.
        </p>

    </div>

    <div class="dashboard-grid">

    <div class="dashboard-card">
        <h3>Total Users</h3>
        <h2><%= stats.total %></h2>
    </div>

    <div class="dashboard-card">
        <h3>Students</h3>
        <h2><%= stats.students %></h2>
    </div>

    <div class="dashboard-card">
        <h3>Teachers</h3>
        <h2><%= stats.teachers %></h2>
    </div>

    <div class="dashboard-card">
        <h3>Admins</h3>
        <h2><%= stats.admins %></h2>
    </div>

</div>

<div class="search-box">

    <input
        type="text"
        id="userSearch"
        placeholder="Search by name or email..."
    >

</div>


    <% if (error) { %>

        <div class="error">
            <%= error %>
        </div>

    <% } %>


    <% if (success) { %>

        <div class="success">
            <%= success %>
        </div>

    <% } %>


    <!-- CREATE TEACHER -->

    <div class="auth-card">

        <h2>
            Create Teacher Account
        </h2>

        <p>
            Only administrators can create teacher accounts.
        </p>


        <form
            action="/admin/users/teacher"
            method="POST"
        >

            <label>
                First Name
            </label>

            <input
                type="text"
                name="first_name"
                required
            >


            <label>
                Last Name
            </label>

            <input
                type="text"
                name="last_name"
                required
            >


            <label>
                Email Address
            </label>

            <input
                type="email"
                name="email"
                required
            >


            <label>
                Temporary Password
            </label>

            <input
                type="password"
                name="password"
                minlength="6"
                required
            >


            <button
                type="submit"
                class="btn primary"
            >
                Create Teacher
            </button>

        </form>

    </div>

          <!-- USER LIST -->

<div class="auth-card">

    <h2>
        Registered Users
    </h2>

    <table class="users-table">

        <thead>

            <tr>

                <th>Name</th>

                <th>Email</th>

                <th>Role</th>

                <th>Actions</th>

            </tr>

        </thead>

        <tbody>

        <% users.forEach(function(member) { %>

            <tr>

                <td>

                    <strong>
                        <%= member.first_name %>
                        <%= member.last_name %>
                    </strong>

                </td>

                <td>

                    <%= member.email %>

                </td>

                <td>

                    <%= member.role %>

                </td>

                <td>

                <a href="/admin/users/edit/<%= member.id %>">
Edit
</a>

|

<a href="/admin/users/reset-password/<%= member.id %>">
Reset Password
</a>

|

<a 
href="/admin/users/delete/<%= member.id %>"
onclick="return confirm('Are you sure you want to delete this user?')">
Delete
</a>

                </td>

            </tr>

        <% }) %>

        </tbody>

    </table>

</main>

<script>

const search =
document.getElementById("userSearch");

search.addEventListener("keyup",function(){

const value =
this.value.toLowerCase();

document.querySelectorAll("tbody tr")
.forEach(row=>{

row.style.display =
row.innerText.toLowerCase().includes(value)
? ""
: "none";

});

});

</script>

</body>

</html>