<!DOCTYPE html>
<html>

<head>

<title>
Attendance Report
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/admin/dashboard">
Dashboard
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<h1>
📊 Attendance Dashboard
</h1>


<p>
Today:
<%= today %>
</p>

</div>



<div class="dashboard-grid">



<div class="dashboard-card analytics-neutral">

<h3>
Total Records
</h3>

<p class="stat-number">

<%= totalRecords %>

</p>

<p class="stat-label">

Attendance entries

</p>

</div>




<div class="dashboard-card analytics-success">

<h3>
🟢 Present
</h3>

<p class="stat-number">

<%= presentPercentage %>%

</p>

<p class="stat-label">

Attendance rate

</p>

</div>




<div class="dashboard-card analytics-danger">

<h3>
🔴 Absent
</h3>

<p class="stat-number">

<%= absentPercentage %>%

</p>

<p class="stat-label">

Absence rate

</p>

</div>




<div class="dashboard-card analytics-warning">

<h3>
🟠 Late
</h3>

<p class="stat-number">

<%= latePercentage %>%

</p>

<p class="stat-label">

Late arrivals

</p>

</div>



</div>





<div class="dashboard-grid">



<div class="dashboard-card">


<h3>
Overall Attendance Breakdown
</h3>


<% summary.forEach(item => { %>


<p>

<strong>
<%= item.status %>
</strong>

:

<%= item.total %>


</p>


<% }) %>


</div>





<div class="dashboard-card">


<h3>
Today's Attendance
</h3>


<% daily.forEach(item => { %>


<p>

<strong>
<%= item.status %>
</strong>

:

<%= item.total %>


</p>


<% }) %>


</div>



</div>

<div class="dashboard-grid">


<!-- =========================
     ATTENDANCE LEADERS
========================= -->


<div class="dashboard-card analytics-success">


<h3>
🏆 Attendance Leaders
</h3>



<% if(ranking.length){ %>


<% ranking.forEach((student, index) => { %>


<p>


<strong>

<%= index + 1 %>.

<%= student.first_name %>

<%= student.last_name %>

</strong>


<br>


Attendance:

<%= student.attendance_rate %>%


<br>


Present:

<%= student.present %>

/

<%= student.total %>


</p>


<hr>


<% }) %>


<% } else { %>


<p>
No attendance records available.
</p>


<% } %>



</div>





<!-- =========================
     LOW ATTENDANCE ALERTS
========================= -->


<div class="dashboard-card analytics-danger">


<h3>
⚠ Students Needing Attention
</h3>




<% if(lowAttendance.length){ %>



<% lowAttendance.forEach(student => { %>


<p>


<strong>

<%= student.first_name %>

<%= student.last_name %>

</strong>


<br>


Attendance:

<%= student.attendance_rate %>%


</p>


<hr>


<% }) %>



<% } else { %>


<p>

✅ No students below 75%.

</p>



<% } %>



</div>



</div>



</main>


</body>

</html>