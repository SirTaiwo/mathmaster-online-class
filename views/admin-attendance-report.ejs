<!DOCTYPE html>
<html>

<head>

<title>
Attendance Report
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<h1>
📊 Attendance Dashboard
</h1>


<h2>
Today:
<%= today %>
</h2>


<div class="dashboard-grid">


<div class="dashboard-card">

<h3>
Overall Attendance
</h3>


<% summary.forEach(item => { %>

<p>

<strong>
<%= item.status %>
</strong>

:
<%= item.total %>

</p>

<% }) %>


</div>



<div class="dashboard-card">

<h3>
Today's Attendance
</h3>


<% daily.forEach(item => { %>

<p>

<strong>
<%= item.status %>
</strong>

:
<%= item.total %>

</p>


<% }) %>


</div>


</div>


</body>

</html>