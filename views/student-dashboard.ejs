<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Student Dashboard</title>

<link rel="stylesheet"
      href="/css/style.css">

</head>

<body>

<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>

<a href="/student/my-courses">
My Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
STUDENT DASHBOARD
</p>

<h1>
Welcome, <%= user.first_name %>!
</h1>

<p>
Track your mathematics learning progress.
</p>

</div>



<div class="dashboard-grid">

<div class="dashboard-card">

<h2>📚 Courses</h2>

<h1><%= summary.courses %></h1>

<p>Courses Enrolled</p>

</div>



<div class="dashboard-card">

<h2>📝 Exercises</h2>

<h1><%= summary.attempted %></h1>

<p>Exercises Attempted</p>

</div>



<div class="dashboard-card">

<h2>✅ Correct</h2>

<h1><%= summary.correct %></h1>

<p>Correct Answers</p>

</div>



<div class="dashboard-card">

<h2>🏆 Marks</h2>

<h1><%= summary.marks %></h1>

<p>Total Marks Earned</p>

</div>



<div class="dashboard-card">

<h2>📊 Accuracy</h2>

<h1><%= summary.accuracy %>%</h1>

<p>Overall Performance</p>

</div>



<div class="dashboard-card">

<h2>🚀 Continue Learning</h2>

<p>Open your mathematics lessons and continue practising.</p>

<a
href="/student/my-courses"
class="btn primary">

My Courses

</a>
<section>

<h2>
📝 Available Assessments
</h2>


<% if(assessments.length === 0){ %>

<p>
No assessments available yet.
</p>


<% } else { %>


<% assessments.forEach(a => { %>


<div class="admin-card">


<h3>
<%= a.title %>
</h3>


<p>
Course:
<%= a.course_title %>
</p>


<p>
Lesson:
<%= a.lesson_title %>
</p>


<p>
Total Marks:
<%= a.total_marks %>
</p>


<a
href="/student/assessments/<%= a.id %>"
class="btn primary">

Take Assessment

</a>


</div>


<% }) %>


<% } %>


</section>
<hr>

<section>
<hr>

<section>

<h2>
📈 My Performance
</h2>


<div class="dashboard-card">

<h3>
📝 Tests Taken
</h3>

<p>
<%= performance.attempts %>
</p>

</div>



<div class="dashboard-card">

<h3>
🏆 Best Score
</h3>

<p>
<%= performance.highest_percentage %>%
</p>

</div>



<div class="dashboard-card">

<h3>
📊 Average Score
</h3>

<p>
<%= performance.average_percentage %>%
</p>

</div>



<div class="dashboard-card">

<h3>
🚀 Latest Attempt
</h3>

<p>
<%= performance.latest_percentage %>%
</p>

</div>


</section>
<h2>
📊 My Assessment Results
</h2>


<% if(results.length === 0){ %>

<p>
No assessment results yet.
</p>


<% } else { %>


<% results.forEach(result => { %>


<div class="dashboard-card">


<h3>
<%= result.assessment_title %>
</h3>


<p>
Score:

<strong>
<%= result.score %> /
<%= result.total_marks %>
</strong>

</p>


<p>
Percentage:

<strong>
<%= result.percentage %>%
</strong>

</p>


<p>
Submitted:

<%= result.submitted_at %>

</p>


</div>


<% }) %>


<% } %>


</section>

</div>

<section>

<h2>
👨‍🏫 Teacher Feedback
</h2>


<% if(feedback.length === 0){ %>

<p>
No feedback from your teacher yet.
</p>


<% } else { %>


<% feedback.forEach(item => { %>


<div class="dashboard-card">


<h3>
Teacher:
<%= item.teacher_first %>
<%= item.teacher_last %>
</h3>


<p>
<%= item.feedback %>
</p>


<p>
<small>
<%= item.created_at %>
</small>
</p>


</div>


<% }) %>


<% } %>


</section>

</div>

</main>

</body>
</html>