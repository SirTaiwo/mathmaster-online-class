<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Control Centre | MathMaster</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>


<body>


<!-- =====================================
     NAVIGATION
====================================== -->

<header>

    <nav class="navbar">

        <div class="logo">
            Math<span>Master</span>
        </div>


        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/admin/dashboard">
                Dashboard
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>

</header>



<!-- =====================================
     MAIN
====================================== -->

<main class="admin-container">


    <div class="admin-heading">

        <p class="eyebrow">
            ADMINISTRATION
        </p>

        <h1>
            Welcome, <%= user.first_name %>!
        </h1>

        <p>
            MathMaster Administration Control Centre
        </p>

    </div>



    <!-- =================================
         STATISTICS
    ================================== -->

    <section class="stats-grid">


        <div class="stat-card">

            <div class="stat-icon">
                👥
            </div>

            <div>

                <p>
                    Total Users
                </p>

                <h2>
                    <%= stats.total %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                🎓
            </div>

            <div>

                <p>
                    Students
                </p>

                <h2>
                    <%= stats.students %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                👩‍🏫
            </div>

            <div>

                <p>
                    Teachers
                </p>

                <h2>
                    <%= stats.teachers %>
                </h2>

            </div>

        </div>



        <div class="stat-card">

            <div class="stat-icon">
                🛡️
            </div>

            <div>

                <p>
                    Administrators
                </p>

                <h2>
                    <%= stats.admins %>
                </h2>

            </div>

        </div>


    </section>



    <!-- =================================
         MANAGEMENT
    ================================== -->

    <section>

        <div class="section-heading">

            <p class="eyebrow">
                MANAGEMENT
            </p>

            <h2>
                System Control
            </h2>

        </div>


        <div class="admin-grid">


            <!-- USERS -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    👥
                </div>

                <h3>
                    User Management
                </h3>

                <p>
                    Create teachers, view students,
                    and manage user accounts.
                </p>

                <a
                    href="/admin/users"
                    class="btn primary"
                >
                    Manage Users
                </a>

            </div>



            <!-- STUDENTS -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    🎓
                </div>

                <h3>
                    Students
                </h3>

                <p>
                    View and manage registered
                    mathematics students.
                </p>

                <a
                    href="/admin/users"
                    class="btn secondary"
                >
                    View Students
                </a>

            </div>



            <!-- TEACHERS -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    👩‍🏫
                </div>

                <h3>
                    Teachers
                </h3>

                <p>
                    Create and manage MathMaster
                    teacher accounts.
                </p>

                <a
                    href="/admin/users"
                    class="btn secondary"
                >
                    Manage Teachers
                </a>

            </div>



            <!-- COURSES -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    📚
                </div>

                <h3>
                    Courses
                </h3>

                <p>
                    Manage mathematics courses,
                    subjects and learning content.
                </p>
  <a href="/student/my-courses">My Courses
</a>

                <button
                    class="btn secondary"
                    disabled
                >
                    Coming Soon
                </button>

            </div>



            <!-- QUIZZES -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    📝
                </div>

                <h3>
                    Quizzes & Tests
                </h3>

                <p>
                    Manage assessments and
                    mathematics tests.
                </p>

                <button
                    class="btn secondary"
                    disabled
                >
                    Coming Soon
                </button>

            </div>



            <!-- REPORTS -->

            <div class="admin-card">

                <div class="admin-card-icon">
                    📊
                </div>

                <h3>
                    Reports
                </h3>

                <p>
                    Monitor student performance,
                    activity and results.
                </p>

                <button
                    class="btn secondary"
                    disabled
                >
                    Coming Soon
                </button>

            </div>


        </div>

    </section>


</main>


</body>

</html>