<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Student Dashboard</title>

<link rel="stylesheet"
      href="/css/style.css">

</head>

<body>

<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>

<a href="/student/my-courses">
My Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
STUDENT DASHBOARD
</p>

<h1>
Welcome, <%= user.first_name %>!
</h1>

<p>
Track your mathematics learning progress.
</p>

</div>



<div class="dashboard-grid">

<div class="dashboard-card">

<h2>📚 Courses</h2>

<h1><%= summary.courses %></h1>

<p>Courses Enrolled</p>

</div>



<div class="dashboard-card">

<h2>📝 Exercises</h2>

<h1><%= summary.attempted %></h1>

<p>Exercises Attempted</p>

</div>



<div class="dashboard-card">

<h2>✅ Correct</h2>

<h1><%= summary.correct %></h1>

<p>Correct Answers</p>

</div>



<div class="dashboard-card">

<h2>🏆 Marks</h2>

<h1><%= summary.marks %></h1>

<p>Total Marks Earned</p>

</div>



<div class="dashboard-card">

<h2>📊 Accuracy</h2>

<h1><%= summary.accuracy %>%</h1>

<p>Overall Performance</p>

</div>



<div class="dashboard-card">

<h2>🚀 Continue Learning</h2>

<p>Open your mathematics lessons and continue practising.</p>

<a
href="/student/my-courses"
class="btn primary">

My Courses

</a>

</div>

</div>

</main>

</body>
</html>