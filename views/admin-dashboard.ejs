<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Admin Dashboard</title>

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

</head>

<body>

<header>

    <nav class="navbar">

        <div class="logo">
            Math<span>Master</span>
        </div>

        <div class="nav-links">

            <a href="/">
                Home
            </a>

            <a href="/logout">
                Logout
            </a>

        </div>

    </nav>

</header>


<body>

<div class="admin-layout">

    <!-- Sidebar -->
    <aside class="sidebar">

        <div class="sidebar-logo">
            Math<span>Master</span>
        </div>

        <ul class="sidebar-menu">

            <li>
                <a href="/admin/dashboard">🏠 Dashboard</a>
            </li>

            <li>
                <a href="/admin/users">👥 Users</a>
            </li>

            <li>
                <a href="/admin/students">👨‍🎓 Students</a>
            </li>

            <li>
                <a href="/admin/teachers">👨‍🏫 Teachers</a>
            </li>

            <li>
                <a href="/admin/classes">📚 Classes</a>
            </li>

            <li>
                <a href="#">📝 Assignments</a>
            </li>

            <li>
                <a href="#">📊 Reports</a>
            </li>

            <li>
                <a href="#">⚙ Settings</a>
            </li>

        </ul>

        <a class="logout-btn" href="/logout">
            🚪 Logout
        </a>

    </aside>


    <!-- Main Content -->

    <main class="main-content">

        <div class="dashboard-header">

            <p class="eyebrow">
                ADMINISTRATION
            </p>

            <h1>
                Welcome,
                <%= user.first_name %>
                <%= user.last_name %>!
            </h1>

            <p>
                Role:
                <strong><%= user.role %></strong>
            </p>

        </div>

        <!-- Dashboard Statistics -->

<div class="dashboard-grid">


    <div class="stat-card">

        <h3>
            Total Users
        </h3>

        <p>
            <%= stats.total %>
        </p>

    </div>



    <div class="stat-card">

        <h3>
            Students
        </h3>

        <p>
            <%= stats.students %>
        </p>

    </div>



    <div class="stat-card">

        <h3>
            Teachers
        </h3>

        <p>
            <%= stats.teachers %>
        </p>

    </div>



    <div class="stat-card">

        <h3>
            Admins
        </h3>

        <p>
            <%= stats.admins %>
        </p>

    </div>


</div>




<!-- Management Modules -->

<section class="module-section">


<h2>
    Management Modules
</h2>



<div class="admin-module-grid">


    <div class="module-card">

        <h3>
            👥 User Management
        </h3>

        <p>
            Manage system users
        </p>

        <a href="/admin/users">
            Open Module
        </a>

    </div>




    <div class="module-card">

        <h3>
            🎓 Student Management
        </h3>

        <p>
            Manage learners
        </p>

        <a href="/admin/students">
    Open Module
</a>

    </div>




    <div class="module-card">

        <h3>
            👨‍🏫 Teacher Management
        </h3>

        <p>
            Manage teachers
        </p>

        <a href="/admin/teachers">
    Open Module
</a>

    </div>




    <div class="module-card">

        <h3>
            📅 Attendance Management
        </h3>

        <p>
            Track attendance
        </p>

        <a href="/admin/attendance">
            Open Module
        </a>

    </div>




    <div class="module-card">

        <h3>
            📝 Assessment & Gradebook
        </h3>

        <p>
            Manage assessments
        </p>

        <a href="#">
            Open Module
        </a>

    </div>




    <div class="module-card">

        <h3>
            📊 Reports & Analytics
        </h3>

        <p>
            View reports
        </p>

        <a href="#">
            Open Module
        </a>

    </div>


</div>


</section>

<!-- Recent Activity -->

<section class="recent-activity">
    <h2>Recent Activity</h2>



    <% if (recentUsers && recentUsers.length > 0) { %>

        <% recentUsers.forEach(member => { %>

            <div class="activity-item">

                <strong>
                    <%= member.first_name %>
                    <%= member.last_name %>
                </strong>

                <br>

                <span>
                    <%= member.role %>
                </span>

                <br>

                <small>
                    Registered:
                    <%= member.created_at %>
                </small>

            </div>

        <% }) %>

    <% } else { %>

        <p>No recent activity.</p>

    <% } %>

</section>

    </main>


</body>

</html>