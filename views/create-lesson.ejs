<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Create Lesson</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/teacher/courses">
Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
CREATE LESSON
</p>


<h1>
<%= course.title %>
</h1>

</div>




<form method="POST"
action="/teacher/courses/<%= course.id %>/lessons/create"
class="form-card">


<label>
Lesson Title
</label>


<input
type="text"
name="title"
placeholder="Example: Algebraic Expressions"
required
>



<label>
Lesson Content
</label>


<textarea
name="content"
rows="8"
placeholder="Enter lesson notes..."
></textarea>



<button
class="btn primary"
type="submit">

Save Lesson

</button>


</form>


</main>


</body>

</html>