<!DOCTYPE html>
<html>

<head>

<title>
Freehand Whiteboard
</title>

<link rel="stylesheet" href="/css/style.css">

<style>

.whiteboard-page {
    max-width: 1400px;
    margin: 0 auto;
}

.whiteboard-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 15px;
}

.whiteboard-toolbar label {
    font-weight: 600;
}

.whiteboard-toolbar input[type="range"] {
    width: 120px;
}

.whiteboard-canvas-wrapper {
    width: 100%;
    background: white;
    border: 2px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
}

#whiteboard {
    display: block;
    width: 100%;
    height: 650px;
    background: white;
    touch-action: none;
    cursor: crosshair;
}

</style>

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/teacher/math-tools">
Mathematics Tools
</a>

<a href="/teacher/dashboard">
Dashboard
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>


<main class="dashboard whiteboard-page">


<div class="dashboard-header">

<h1>
✏️ Freehand Whiteboard
</h1>

<p>
Write mathematics naturally using your stylus or mouse.
</p>

</div>


<div class="whiteboard-toolbar">

<button
type="button"
class="btn primary"
id="penButton">

✏️ Pen

</button>


<button
type="button"
class="btn"
id="eraserButton">

🧹 Eraser

</button>


<label for="lineWidth" id="lineWidthLabel">
Pen thickness:
</label>

<input
type="range"
id="lineWidth"
min="1"
max="20"
value="3">


<button
type="button"
class="btn"
id="undoButton">

↩️ Undo

</button>


<button
type="button"
class="btn"
id="clearButton">

🗑️ Clear

</button>

</div>


<div class="whiteboard-canvas-wrapper">

<canvas id="whiteboard"></canvas>

</div>


</main>


<script>

const canvas =
    document.getElementById("whiteboard");

const ctx =
    canvas.getContext("2d");


const penButton =
    document.getElementById("penButton");

const eraserButton =
    document.getElementById("eraserButton");

const lineWidth =
    document.getElementById("lineWidth");

    const lineWidthLabel =
    document.getElementById("lineWidthLabel");

const undoButton =
    document.getElementById("undoButton");

const clearButton =
    document.getElementById("clearButton");


let drawing = false;

let erasing = false;

let lastX = 0;

let lastY = 0;

let history = [];


function resizeCanvas() {

    const rect =
        canvas.getBoundingClientRect();

    const previousImage =
        canvas.toDataURL();

    canvas.width =
        rect.width * window.devicePixelRatio;

    canvas.height =
        rect.height * window.devicePixelRatio;

    ctx.scale(
        window.devicePixelRatio,
        window.devicePixelRatio
    );

    ctx.lineCap = "round";

    ctx.lineJoin = "round";

    const image =
        new Image();

    image.onload = () => {

        ctx.drawImage(
            image,
            0,
            0,
            rect.width,
            rect.height
        );

    };

    image.src = previousImage;

}


function getPosition(event) {

    const rect =
        canvas.getBoundingClientRect();

    return {

        x:
            event.clientX -
            rect.left,

        y:
            event.clientY -
            rect.top

    };

}


function startDrawing(event) {

    event.preventDefault();

    drawing = true;

    const position =
        getPosition(event);

    lastX = position.x;

    lastY = position.y;

    canvas.setPointerCapture(event.pointerId);

    history.push(
        canvas.toDataURL()
    );

}


function draw(event) {

    if (!drawing) {
        return;
    }

    event.preventDefault();

    const position =
        getPosition(event);

    ctx.lineWidth =
        Number(lineWidth.value);

    ctx.globalCompositeOperation =
        erasing
            ? "destination-out"
            : "source-over";

    ctx.beginPath();

    ctx.moveTo(
        lastX,
        lastY
    );

    ctx.lineTo(
        position.x,
        position.y
    );

    ctx.stroke();

    lastX = position.x;

    lastY = position.y;

}


function stopDrawing(event) {

    if (!drawing) {
        return;
    }

    drawing = false;

    if (
        event.pointerId !== undefined &&
        canvas.hasPointerCapture(event.pointerId)
    ) {

        canvas.releasePointerCapture(
            event.pointerId
        );

    }

}


canvas.addEventListener(
    "pointerdown",
    startDrawing
);

canvas.addEventListener(
    "pointermove",
    draw
);

canvas.addEventListener(
    "pointerup",
    stopDrawing
);

canvas.addEventListener(
    "pointercancel",
    stopDrawing
);


penButton.addEventListener(
    "click",
    () => {

        erasing = false;

        lineWidth.min = "1";

        lineWidth.max = "20";

        lineWidth.value = "3";

        lineWidthLabel.textContent =
            "Pen thickness:";

        ctx.globalCompositeOperation =
            "source-over";

    }
);


eraserButton.addEventListener(
    "click",
    () => {

        erasing = true;

        lineWidth.min = "5";

        lineWidth.max = "60";

        lineWidth.value = "30";

        lineWidthLabel.textContent =
            "Eraser size:";

        ctx.globalCompositeOperation =
            "destination-out";

    }
);


undoButton.addEventListener(
    "click",
    () => {

        if (history.length === 0) {
            return;
        }

        const previous =
            history.pop();

        const image =
            new Image();

        image.onload = () => {

            const rect =
                canvas.getBoundingClientRect();

            ctx.clearRect(
                0,
                0,
                rect.width,
                rect.height
            );

            ctx.drawImage(
                image,
                0,
                0,
                rect.width,
                rect.height
            );

        };

        image.src = previous;

    }
);


clearButton.addEventListener(
    "click",
    () => {

        const rect =
            canvas.getBoundingClientRect();

        history.push(
            canvas.toDataURL()
        );

        ctx.clearRect(
            0,
            0,
            rect.width,
            rect.height
        );

    }
);


window.addEventListener(
    "resize",
    resizeCanvas
);


resizeCanvas();

</script>


</body>

</html>