<!DOCTYPE html>
<html>

<head>

<title>
Calculator Workspace
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/math-tools">
Math Tools
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<h1>
🧮 Calculator Workspace
</h1>

<p>
Perform mathematical calculations quickly during mathematics lessons.
</p>

</div>



<div class="dashboard-card">


<h2>
🧮 Mathematics Calculator
</h2>


<input
type="text"
id="calculatorDisplay"
readonly
value="0"
style="width:100%; box-sizing:border-box; font-size:2rem; text-align:right; padding:15px; margin-bottom:15px;"
>


<div
style="display:grid; grid-template-columns:repeat(4, 1fr); gap:10px;"
>


<button
onclick="calculatorClear()"
class="btn">

AC

</button>


<button
onclick="calculatorBackspace()"
class="btn">

⌫

</button>


<button
onclick="calculatorPercentage()"
class="btn">

%

</button>


<button
onclick="calculatorInput('/')"
class="btn primary">

÷

</button>



<button
onclick="calculatorInput('7')"
class="btn">

7

</button>


<button
onclick="calculatorInput('8')"
class="btn">

8

</button>


<button
onclick="calculatorInput('9')"
class="btn">

9

</button>


<button
onclick="calculatorInput('*')"
class="btn primary">

×

</button>



<button
onclick="calculatorInput('4')"
class="btn">

4

</button>


<button
onclick="calculatorInput('5')"
class="btn">

5

</button>


<button
onclick="calculatorInput('6')"
class="btn">

6

</button>


<button
onclick="calculatorInput('-')"
class="btn primary">

−

</button>



<button
onclick="calculatorInput('1')"
class="btn">

1

</button>


<button
onclick="calculatorInput('2')"
class="btn">

2

</button>


<button
onclick="calculatorInput('3')"
class="btn">

3

</button>


<button
onclick="calculatorInput('+')"
class="btn primary">

+

</button>



<button
onclick="calculatorInput('0')"
class="btn">

0

</button>


<button
onclick="calculatorInput('.')"
class="btn">

.

</button>


<button
onclick="calculatorInput('(')"
class="btn">

(

</button>


<button
onclick="calculatorInput(')')"
class="btn">

)

</button>


</div>



<br>


<button
onclick="calculatorCalculate()"
class="btn primary"
style="width:100%; font-size:1.2rem;">

=

</button>


</div>



<div class="dashboard-card">


<h2>
📜 Calculation History
</h2>


<div id="calculatorHistory">

<p>
No calculations yet.
</p>

</div>


<button
onclick="clearCalculatorHistory()"
class="btn">

Clear History

</button>


</div>



</main>



<script src="/js/teacher-calculator.js"></script>


</body>

</html>
