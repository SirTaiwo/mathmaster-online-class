<!DOCTYPE html>
<html lang="en">

<head>

<title>
Student Attendance
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>

<a href="/student/finance">
Finance
</a>

</div>

</nav>

</header>


<main class="dashboard">


<div class="dashboard-header">

<h1>
📊 My Attendance
</h1>

<p>
<%= user.first_name %>
<%= user.last_name %>
</p>

</div>


<!-- ========================================
     ATTENDANCE SUMMARY
======================================== -->

<div class="dashboard-grid">


<div class="dashboard-card analytics-neutral">

<h3>
Total Records
</h3>

<p class="stat-number">
<%= summary.total %>
</p>

<p class="stat-label">
Attendance records
</p>

</div>


<div class="dashboard-card analytics-success">

<h3>
🟢 Present
</h3>

<p class="stat-number">
<%= summary.present %>
</p>

<p class="stat-label">
Present days
</p>

</div>


<div class="dashboard-card analytics-danger">

<h3>
🔴 Absent
</h3>

<p class="stat-number">
<%= summary.absent %>
</p>

<p class="stat-label">
Absent days
</p>

</div>


<div class="dashboard-card analytics-warning">

<h3>
🟠 Late
</h3>

<p class="stat-number">
<%= summary.late %>
</p>

<p class="stat-label">
Late arrivals
</p>

</div>


</div>


<!-- ========================================
     ATTENDANCE RATE
======================================== -->

<div class="dashboard-card">

<h2>
Attendance Rate
</h2>

<p class="stat-number">
<%= summary.attendanceRate %>%
</p>

<p>
Based on <%= summary.total %> attendance records.
</p>

</div>


<!-- ========================================
     ATTENDANCE HISTORY
======================================== -->

<div class="dashboard-card">

<h2>
Attendance History
</h2>


<% if (attendance.length === 0) { %>

<p>
No attendance records available yet.
</p>

<% } else { %>


<table class="admin-table">

<thead>

<tr>

<th>
Date
</th>

<th>
Status
</th>

<th>
Remarks
</th>

</tr>

</thead>


<tbody>


<% attendance.forEach(record => { %>

<tr>

<td>
<%= record.attendance_date %>
</td>


<td>

<% if (record.status === "Present") { %>

🟢 Present

<% } else if (record.status === "Absent") { %>

🔴 Absent

<% } else if (record.status === "Late") { %>

🟠 Late

<% } else if (record.status === "Excused") { %>

🔵 Excused

<% } else { %>

<%= record.status %>

<% } %>

</td>


<td>
<%= record.remarks || "-" %>
</td>

</tr>

<% }) %>


</tbody>

</table>


<% } %>


</div>


</main>


</body>

</html>
