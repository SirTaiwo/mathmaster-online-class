<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>
Reports & Analytics
</title>

<link rel="stylesheet"
      href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div>
<a href="/admin/dashboard">
    Admin Dashboard
</a>

<a href="/logout">
    Logout
</a>
</div>

</nav>

</header>


<main class="container">


<h1>
Reports & Analytics
</h1>

<p>
Central reporting and analytics for the MathMaster system.
</p>


<!-- ======================================== -->
<!-- SYSTEM OVERVIEW -->
<!-- ======================================== -->

<h2>
System Overview
</h2>


<div class="module-grid">


<div class="module-card">

<h3>
Total Users
</h3>

<p>
<%= stats.total %>
</p>

</div>


<div class="module-card">

<h3>
Students
</h3>

<p>
<%= stats.students %>
</p>

</div>


<div class="module-card">

<h3>
Teachers
</h3>

<p>
<%= stats.teachers %>
</p>

</div>


<div class="module-card">

<h3>
Administrators
</h3>

<p>
<%= stats.admins %>
</p>

</div>


<div class="module-card">

<h3>
Classes
</h3>

<p>
<%= classCount %>
</p>

</div>


</div>


<!-- ======================================== -->
<!-- ACADEMIC REPORTS -->
<!-- ======================================== -->

<h2>
Academic Reports
</h2>


<div class="module-grid">


<div class="module-card">

<h3>
Assessment & Gradebook
</h3>

<p>
View assessment attempts, scores,
pass rates and performance distribution.
</p>

<a href="/admin/assessment-gradebook">
    Open Report
</a>

</div>


<div class="module-card">

<h3>
Attendance Report
</h3>

<p>
View attendance summaries,
trends and attendance performance.
</p>

<a href="/admin/attendance">
    Open Report
</a>

</div>


</div>


<!-- ======================================== -->
<!-- FINANCIAL REPORTS -->
<!-- ======================================== -->

<h2>
Financial Reports
</h2>


<div class="module-grid">


<div class="module-card">

<h3>
Finance Management
</h3>

<p>
Manage and review student financial records.
</p>

<a href="/admin/finance">
    Open Report
</a>

</div>


<div class="module-card">

<h3>
Invoices
</h3>

<p>
View and manage student invoices.
</p>

<a href="/admin/invoices">
    Open Report
</a>

</div>


<div class="module-card">

<h3>
Payments
</h3>

<p>
Review recorded student payments.
</p>

<a href="/admin/payments">
    Open Report
</a>

</div>


<div class="module-card">

<h3>
Receipts
</h3>

<p>
View and manage payment receipts.
</p>

<a href="/admin/receipts">
    Open Report
</a>

</div>


<div class="module-card">

<h3>
Student Fees
</h3>

<p>
Manage student fee records.
</p>

<a href="/admin/student-fees">
    Open Report
</a>

</div>


</div>


<br>


<a href="/admin/dashboard">
    ← Back to Admin Dashboard
</a>


</main>


</body>

</html>
