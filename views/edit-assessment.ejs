<!DOCTYPE html>
<html>

<head>

    <title>Edit Assessment</title>

    <link rel="stylesheet" href="/css/style.css">

</head>

<body>

<div class="container">

<h1>
✏ Edit Assessment
</h1>

<form
    action="/teacher/assessments/<%= assessment.id %>/edit"
    method="POST">

    <label>
        Title
    </label>

    <input
        type="text"
        name="title"
        value="<%= assessment.title %>"
        required>


    <label>
        Description
    </label>

    <textarea
        name="description"
        rows="6"><%= assessment.description %></textarea>


    <label>
        Total Marks
    </label>

    <input
        type="number"
        name="totalMarks"
        value="<%= assessment.total_marks %>"
        required>


    <br><br>

    <button
        class="btn btn-primary">

        💾 Save Changes

    </button>

</form>

<br>

<a href="/teacher/assessments">
⬅ Back to Assessments
</a>

</div>

</body>

</html>