<!DOCTYPE html>

<html>

<head>

<title>
Course Gradebook
</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/courses">
Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">


<p class="eyebrow">
GRADEBOOK
</p>


<h1>
<%= course.title %>
</h1>


<!-- ========================================
     COURSE GRADEBOOK SUMMARY
========================================= -->

<div class="dashboard-grid" style="margin-bottom: 30px;">

<div class="dashboard-card">

<p class="eyebrow">
TOTAL STUDENTS
</p>

<h2>
<%= totalStudents %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
ACTIVE STUDENTS
</p>

<h2>
<%= activeStudents %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
COURSE AVERAGE
</p>

<h2>
<%= courseAverage %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
NEEDS SUPPORT
</p>

<h2>
<%= studentsNeedingSupport %>
</h2>

</div>

</div>


<table>

<tr>

<th>
Student
</th>

<th>
Attempts
</th>

<th>
Correct
</th>

<th>
Incorrect
</th>

<th>
Marks
</th>

<th>
Score
</th>

<th>
Performance
</th>

</tr>

<% students.forEach(function(student){ %>

<tr>

<td>
<a href="/teacher/students/<%= student.student_id %>/performance">
<%= student.first_name %>
<%= student.last_name %>
</a>
</td>

<td>
<%= student.attempts %>
</td>

<td>
<%= student.correct %>
</td>

<td>
<%= student.incorrect %>
</td>

<td>
<%= student.marks %> / <%= student.total_possible_marks %>
</td>

<td>
<%= student.scorePercentage %>%
</td>

<td>
<%= student.performanceIcon %>
<%= student.performanceStatus %>
</td>

</tr>

<% }) %>

</table>

</html>