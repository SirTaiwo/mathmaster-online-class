<!DOCTYPE html>

<html>

<head>

<title>
Course Gradebook
</title>

<link rel="stylesheet" href="/css/style.css">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/courses">
Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">


<p class="eyebrow">
GRADEBOOK
</p>


<h1>
<%= course.title %>
</h1>


<!-- ========================================
     COURSE GRADEBOOK SUMMARY
========================================= -->

<div class="dashboard-grid" style="margin-bottom: 30px;">

<div class="dashboard-card">

<p class="eyebrow">
TOTAL STUDENTS
</p>

<h2>
<%= totalStudents %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
ACTIVE STUDENTS
</p>

<h2>
<%= activeStudents %>
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
COURSE AVERAGE
</p>

<h2>
<%= courseAverage %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
NEEDS SUPPORT
</p>

<h2>
<%= studentsNeedingSupport %>
</h2>

</div>

</div>


<!-- ========================================
     COURSE PERFORMANCE ANALYTICS
========================================= -->

<div class="dashboard-card" style="margin-bottom: 30px;">

<p class="eyebrow">
COURSE PERFORMANCE ANALYTICS
</p>

<div class="dashboard-grid">

<div class="dashboard-card">

<p class="eyebrow">
HIGHEST SCORE
</p>

<h2>
<%= highestScore %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
LOWEST SCORE
</p>

<h2>
<%= lowestScore %>%
</h2>

</div>


<div class="dashboard-card">

<p class="eyebrow">
PASS RATE
</p>

<h2>
<%= passRate %>%
</h2>

</div>

</div>

</div>


<!-- ========================================
     TOP PERFORMING STUDENTS
========================================= -->

<div class="dashboard-card" style="margin-bottom: 30px;">

<p class="eyebrow">
TOP PERFORMING STUDENTS
</p>

<h2>
Highest Course Scores
</h2>

<% if (topPerformingStudents.length > 0) { %>

<table>

<tr>

<th>
Rank
</th>

<th>
Student
</th>

<th>
Score
</th>

<th>
Performance
</th>

</tr>

<% topPerformingStudents.forEach(function(student, index){ %>

<tr>

<td>
<%= index + 1 %>
</td>

<td>
<a href="/teacher/students/<%= student.student_id %>/performance">
<%= student.first_name %>
<%= student.last_name %>
</a>
</td>

<td>
<strong>
<%= student.scorePercentage %>%
</strong>
</td>

<td>
<%= student.performanceIcon %>
<%= student.performanceStatus %>
</td>

</tr>

<% }) %>

</table>

<% } else { %>

<p>
No students have completed any course activity yet.
</p>

<% } %>

</div>


<!-- ========================================
     STUDENT SEARCH & FILTER
========================================= -->

<div class="dashboard-card" style="margin-bottom: 25px;">

<p class="eyebrow">
STUDENT FILTER
</p>

<div style="display: flex; gap: 15px; flex-wrap: wrap; align-items: center;">

<input
    type="text"
    id="studentSearch"
    placeholder="Search student..."
    style="padding: 10px; min-width: 250px;"
>

<select
    id="performanceFilter"
    style="padding: 10px;"
>

<option value="all">
All Students
</option>

<option value="Excellent">
Excellent
</option>

<option value="Good">
Good
</option>

<option value="Satisfactory">
Satisfactory
</option>

<option value="Needs Improvement">
Needs Improvement
</option>

<option value="No Activity">
No Activity
</option>

</select>

<button
    type="button"
    onclick="clearStudentFilters()"
    style="padding: 10px 15px;"
>
Clear Filters
</button>

</div>

</div>


<table id="studentGradebookTable">

<tr>

<th>
Student
</th>

<th>
Attempts
</th>

<th>
Correct
</th>

<th>
Incorrect
</th>

<th>
Marks
</th>

<th>
Score
</th>

<th>
Performance
</th>

</tr>

<% students.forEach(function(student){ %>

<tr>

<td>
<a href="/teacher/students/<%= student.student_id %>/performance">
<%= student.first_name %>
<%= student.last_name %>
</a>
</td>

<td>
<%= student.attempts %>
</td>

<td>
<%= student.correct %>
</td>

<td>
<%= student.incorrect %>
</td>

<td>
<%= student.marks %> / <%= student.total_possible_marks %>
</td>

<td>
<%= student.scorePercentage %>%
</td>

<td>
<%= student.performanceIcon %>
<%= student.performanceStatus %>
</td>

</tr>

<% }) %>

</table>

</div>


<script>

const studentSearch =
    document.getElementById("studentSearch");

const performanceFilter =
    document.getElementById("performanceFilter");

const studentGradebookTable =
    document.getElementById("studentGradebookTable");


function filterStudents() {

    const searchTerm =
        studentSearch.value
            .toLowerCase()
            .trim();

    const selectedPerformance =
        performanceFilter.value;

    const rows =
        studentGradebookTable.querySelectorAll(
            "tr:not(:first-child)"
        );

    let visibleStudents = 0;

    rows.forEach(function(row) {

        const studentName =
            row.cells[0]
                ? row.cells[0].innerText
                    .toLowerCase()
                    .trim()
                : "";

        const performance =
            row.cells[6]
                ? row.cells[6].innerText
                    .trim()
                : "";

        const matchesSearch =
            studentName.includes(
                searchTerm
            );

        const matchesPerformance =
            selectedPerformance === "all" ||
            performance.includes(
                selectedPerformance
            );

        if (
            matchesSearch &&
            matchesPerformance
        ) {

            row.style.display = "";

            visibleStudents++;

        } else {

            row.style.display = "none";

        }

    });

    updateNoResultsMessage(
        visibleStudents
    );

}


function updateNoResultsMessage(
    visibleStudents
) {

    let message =
        document.getElementById(
            "studentFilterNoResults"
        );

    if (visibleStudents === 0) {

        if (!message) {

            message =
                document.createElement(
                    "p"
                );

            message.id =
                "studentFilterNoResults";

            message.textContent =
                "No students match the selected filters.";

            message.style.textAlign =
                "center";

            message.style.padding =
                "20px";

            studentGradebookTable
                .parentNode
                .insertBefore(
                    message,
                    studentGradebookTable
                );

        }

    } else {

        if (message) {

            message.remove();

        }

    }

}


function clearStudentFilters() {

    studentSearch.value = "";

    performanceFilter.value = "all";

    filterStudents();

}


studentSearch.addEventListener(
    "input",
    filterStudents
);

performanceFilter.addEventListener(
    "change",
    filterStudents
);

</script>


<!-- ========================================
     PERFORMANCE DISTRIBUTION
========================================= -->

<div class="dashboard-card" style="margin-top: 30px;">

<p class="eyebrow">
PERFORMANCE DISTRIBUTION
</p>

<h2>
Student Performance Overview
</h2>

<p style="color: #666; margin-bottom: 20px;">
Students grouped by their current course performance level.
</p>

<div style="max-width: 700px; margin: 0 auto;">

<canvas id="performanceDistributionChart"></canvas>

</div>

</div>

<script>

const performanceData = {

    excellent: <%= performanceDistribution.excellent %>,
    good: <%= performanceDistribution.good %>,
    satisfactory: <%= performanceDistribution.satisfactory %>,
    needsImprovement: <%= performanceDistribution.needsImprovement %>,
    noActivity: <%= performanceDistribution.noActivity %>

};

const performanceCtx =
    document.getElementById(
        "performanceDistributionChart"
    );

new Chart(
    performanceCtx,
    {
        type: "bar",

        data: {

            labels: [
                "Excellent",
                "Good",
                "Satisfactory",
                "Needs Improvement",
                "No Activity"
            ],

            datasets: [{

                label: "Students",

                data: [
                    performanceData.excellent,
                    performanceData.good,
                    performanceData.satisfactory,
                    performanceData.needsImprovement,
                    performanceData.noActivity
                ]

            }]

        },

        options: {

            responsive: true,

            scales: {

                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }

            }

        }
    }
);

</script>

</html>