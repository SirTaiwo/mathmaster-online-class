<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Courses</title>

<link rel="stylesheet" href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/teacher/dashboard">
Dashboard
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
TEACHER COURSES
</p>


<h1>
My Mathematics Courses
</h1>


<p>
Welcome,
<strong>
<%= user.first_name %>
</strong>
</p>


<a href="/teacher/courses/create"
class="btn primary">

Create New Course

</a>


</div>



<div class="dashboard-grid">


<% if (courses.length === 0) { %>


<div class="dashboard-card">

<h3>
No Courses Yet
</h3>

<p>
Create your first mathematics course.
</p>

</div>


<% } %>



<% courses.forEach(course => { %>


<div class="dashboard-card">


<h3>
<%= course.title %>
</h3>


<p>
Grade:
<strong>
<%= course.grade %>
</strong>
</p>


<p>
<%= course.description %>
</p>

<a href="/teacher/courses/<%= course.id %>/lessons">
    Manage Lessons
</a>

<a href="/teacher/courses/delete/<%= course.id %>">

Delete

</a>


</div>


<% }) %>


</div>


</main>


</body>

</html>