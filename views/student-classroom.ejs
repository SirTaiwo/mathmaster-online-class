<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>
Live Classroom - <%= course.title %>
</title>

<link rel="stylesheet"
      href="/css/style.css">

</head>

<body>

<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/student/dashboard">
Dashboard
</a>

<a href="/student/my-courses">
My Courses
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>


<main class="dashboard">

<div class="dashboard-header">

<p class="eyebrow">
LIVE CLASSROOM
</p>

<h1>
<%= course.title %>
</h1>

<p>
Grade:
<strong><%= course.grade %></strong>
</p>

</div>


<div
    class="dashboard-card"
    style="border-left: 5px solid #2e7d32;"
>

<h2>
🟢 Live Classroom Active
</h2>

<p>
You have successfully joined the live classroom.
</p>

<p>
<strong>Started:</strong>
<%= activeSession.started_at %>
</p>

<p>
Your teacher is currently conducting this classroom session.
</p>

</div>

<div
    id="classroom-feedback-status"
    class="dashboard-card"
    style="margin-top: 20px;"
>
</h2>

<%
const feedbackInteractions =
    classroomInteractions;
%>

<% if (feedbackInteractions.length === 0) { %>

    <p>
    You have not sent any classroom feedback yet.
    </p>

<% } else { %>

    <% feedbackInteractions.forEach((interaction) => { %>

        <div
            style="margin-bottom: 15px;"
        >

        <p>
<strong>

<% if (interaction.interaction_type === "understand") { %>
    👍 Understand:
<% } else if (interaction.interaction_type === "not_sure") { %>
    🤔 Not Sure:
<% } else if (interaction.interaction_type === "need_help") { %>
    🆘 Need Help:
<% } else if (interaction.interaction_type === "repeat") { %>
    🔁 Repeat:
<% } else if (interaction.interaction_type === "raise_hand") { %>
    ✋ Raise Hand:
<% } else { %>
    <%= interaction.interaction_type %>:
<% } %>

</strong>

<%= interaction.created_at %>
</p>

        <% if (interaction.acknowledged_at) { %>

            <p>
            <strong>
            ✅ Teacher Acknowledged:
            </strong>
            <%= interaction.acknowledged_at %>
            </p>

        <% } else { %>

            <p>
            <em>
            Waiting for teacher acknowledgement.
            </em>
            </p>

        <% } %>

        </div>

    <% }); %>

<% } %>

</div>

<div
    class="dashboard-card"
    style="margin-top: 20px;"
>

<h2>
How are you following the lesson?
</h2>

<p>
Let your teacher know how you are doing.
</p>


<div
    style="display: flex; flex-wrap: wrap; gap: 10px;"
>


<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/interaction"
>

<input
    type="hidden"
    name="interactionType"
    value="understand"
>

<button
    class="btn primary"
    type="submit"
>
👍 Understand
</button>

</form>


<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/interaction"
>

<input
    type="hidden"
    name="interactionType"
    value="not_sure"
>

<button
    class="btn secondary"
    type="submit"
>
🤔 Not Sure
</button>

</form>


<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/interaction"
>

<input
    type="hidden"
    name="interactionType"
    value="need_help"
>

<button
    class="btn secondary"
    type="submit"
>
🆘 Need Help
</button>

</form>


<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/interaction"
>

<input
    type="hidden"
    name="interactionType"
    value="repeat"
>

<button
    class="btn secondary"
    type="submit"
>
🔁 Repeat
</button>

</form>

<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/interaction"
>

<input
    type="hidden"
    name="interactionType"
    value="raise_hand"
>

<button
    class="btn secondary"
    type="submit"
>
✋ Raise Hand
</button>

</form>


</div>

</div>

<div
    class="dashboard-card"
    style="margin-top: 20px;"
>

<h2>
💬 Message Your Teacher
</h2>

<p>
Have a question or something you would like your teacher to know?
</p>

<form
    method="POST"
    action="/student/courses/<%= course.id %>/classroom/message"
>

<textarea
    name="message"
    rows="4"
    placeholder="Type your question or message here..."
    style="width: 100%; max-width: 700px; padding: 10px; box-sizing: border-box;"
></textarea>

<br><br>

<button
    class="btn primary"
    type="submit"
>
Send Message
</button>

</form>

</div>

<div
    id="classroom-messages"
    class="dashboard-card"
    style="margin-top: 20px;"
>
</h2>

<% if (classroomMessages.length === 0) { %>

    <p>
    You have not sent any classroom messages yet.
    </p>

<% } else { %>

    <% classroomMessages.slice().reverse().forEach((message) => { %>

        <div
            style="margin-bottom: 20px;"
        >

        <p>
        <strong>
        Your Message:
        </strong>
        <%= message.message %>
        </p>

        <p>
        <strong>
        Sent:
        </strong>
        <%= message.created_at %>
        </p>

        <% if (message.teacher_response) { %>

            <p>
            <strong>
            👨‍🏫 Teacher Response:
            </strong>
            <%= message.teacher_response %>
            </p>

            <p>
            <strong>
            Responded:
            </strong>
            <%= message.responded_at %>
            </p>

        <% } else { %>

            <p>
            <em>
            Your teacher has not responded yet.
            </em>
            </p>

        <% } %>

        </div>

    <% }); %>

<% } %>

</div>

<div
    style="margin-top: 20px;"
>

<a
    href="/student/courses/<%= course.id %>/lessons"
    class="btn secondary"
>
← Back to Course Lessons
</a>

</div>

<script>

const classroomStatusUrl =
    "/student/courses/<%= course.id %>/classroom/status";


function escapeHtml(value) {

    return String(value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

}


async function refreshClassroomStatus() {

    try {

        const response =
            await fetch(classroomStatusUrl);

        if (!response.ok) {
            return;
        }

        const data =
            await response.json();


        if (!data.success || !data.active) {
            return;
        }


        // ----------------------------------------
        // REFRESH FEEDBACK STATUS
        // ----------------------------------------

        const feedbackContainer =
            document.getElementById(
                "classroom-feedback-status"
            );


        if (feedbackContainer) {

            const interactions =
                data.classroomInteractions || [];


            let html = `
                <h2>
                📊 My Classroom Feedback Status
                </h2>
            `;


            if (interactions.length === 0) {

                html += `
                    <p>
                    You have not sent any classroom feedback yet.
                    </p>
                `;

            } else {

                interactions.forEach((interaction) => {

                    let label =
                        interaction.interaction_type;


                    if (interaction.interaction_type === "understand") {
                        label = "👍 Understand";
                    } else if (interaction.interaction_type === "not_sure") {
                        label = "🤔 Not Sure";
                    } else if (interaction.interaction_type === "need_help") {
                        label = "🆘 Need Help";
                    } else if (interaction.interaction_type === "repeat") {
                        label = "🔁 Repeat";
                    } else if (interaction.interaction_type === "raise_hand") {
                        label = "✋ Raise Hand";
                    }


                    html += `
                        <div style="margin-bottom: 15px;">

                            <p>
                                <strong>
                                ${label}:
                                </strong>
                                ${interaction.created_at}
                            </p>
                    `;


                    if (interaction.acknowledged_at) {

                        html += `
                            <p>
                                <strong>
                                ✅ Teacher Acknowledged:
                                </strong>
                                ${interaction.acknowledged_at}
                            </p>
                        `;

                    } else {

                        html += `
                            <p>
                                <em>
                                Waiting for teacher acknowledgement.
                                </em>
                            </p>
                        `;

                    }


                    html += `
                        </div>
                    `;

                });

            }


            feedbackContainer.innerHTML =
                html;

        }


        // ----------------------------------------
        // REFRESH CLASSROOM MESSAGES
        // ----------------------------------------

        const messagesContainer =
            document.getElementById(
                "classroom-messages"
            );


        if (messagesContainer) {

            const messages =
                data.classroomMessages || [];


            let html = `
                <h2>
                📨 My Classroom Messages
                </h2>
            `;


            if (messages.length === 0) {

                html += `
                    <p>
                    You have not sent any classroom messages yet.
                    </p>
                `;

            } else {

                messages
                    .slice()
                    .reverse()
                    .forEach((message) => {

                        html += `
                            <div style="margin-bottom: 20px;">

                                <p>
                                    <strong>
                                    Your Message:
                                    </strong>
                                    ${escapeHtml(message.message)}
                                </p>

                                <p>
                                    <strong>
                                    Sent:
                                    </strong>
                                    ${message.created_at}
                                </p>
                        `;


                        if (message.teacher_response) {

                            html += `
                                <p>
                                    <strong>
                                    👨‍🏫 Teacher Response:
                                    </strong>
                                    ${escapeHtml(message.teacher_response)}
                                </p>

                                <p>
                                    <strong>
                                    Responded:
                                    </strong>
                                    ${message.responded_at}
                                </p>
                            `;

                        } else {

                            html += `
                                <p>
                                    <em>
                                    Your teacher has not responded yet.
                                    </em>
                                </p>
                            `;

                        }


                        html += `
                            </div>
                        `;

                    });

            }


            messagesContainer.innerHTML =
                html;

        }

    } catch (error) {

        console.error(
            "Classroom status refresh failed:",
            error
        );

    }

}


// Refresh every 5 seconds.

setInterval(
    refreshClassroomStatus,
    5000
);

</script>

</main>

</body>

</html>
