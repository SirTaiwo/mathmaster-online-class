<!DOCTYPE html>
<html>

<head>

<title>
Parent Dashboard
</title>

<link
rel="stylesheet"
href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<h1>
Welcome,
<%= user.first_name %>
</h1>


<p>
Parent Portal
</p>



<h2>
👨‍🎓 My Children
</h2>



<div class="dashboard-grid">


<% children.forEach(child => { %>


<div class="dashboard-card">


<h3>

<%= child.first_name %>

<%= child.last_name %>

</h3>


<p>
Grade:
<%= child.grade %>
</p>


<p>
Relationship:
<%= child.relationship || "Guardian" %>
</p>


<hr>


<h4>
📊 Performance
</h4>


<p>
Tests Taken:

<%= child.performance.attempts || 0 %>

</p>


<p>
Average Score:

<%= child.performance.average_percentage || 0 %>%

</p>


<p>
Highest Score:

<%= child.performance.highest_percentage || 0 %>%

</p>



</div>


<% }) %>



</div>



</main>


</body>

</html>