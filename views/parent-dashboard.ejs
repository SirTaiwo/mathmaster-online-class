<!DOCTYPE html>
<html>

<head>

<title>
Parent Dashboard
</title>

<link
rel="stylesheet"
href="/css/style.css">

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<h1>
Welcome,
<%= user.first_name %>
</h1>


<p>
Parent Portal
</p>



<h2>
👨‍🎓 My Children
</h2>



<div class="dashboard-grid">


<% children.forEach(child => { %>


<div class="dashboard-card">


<h3>

<%= child.first_name %>

<%= child.last_name %>

</h3>


<p>
Grade:
<%= child.grade %>
</p>


<p>
Relationship:
<%= child.relationship || "Guardian" %>
</p>


<hr>


<h4>
📊 Performance
</h4>


<p>
Tests Taken:

<%= child.performance.attempts || 0 %>

</p>


<p>
Average Score:

<%= child.performance.average_percentage || 0 %>%

</p>


<p>
Highest Score:

<%= child.performance.highest_percentage || 0 %>%

</p>



</div>



<h3>📈 Progress Trend</h3>

<div class="dashboard-card">

<% child.progressTrend.forEach((attempt, index) => { %>

<p>

<strong>
Attempt <%= index + 1 %>
</strong>

—

<%= attempt.percentage %>%

<br>

<small>
<%= attempt.submitted_at %>
</small>

</p>

<% }) %>

</div>

<h3>📝 Assessment History</h3>

<div class="dashboard-card">

<% child.assessmentHistory.forEach(result => { %>

<p>

<strong>
<%= result.assessment_title %>
</strong>

<br>

Score:
<%= result.score %> /
<%= result.total_marks %>

<br>

Percentage:
<%= result.percentage %>%

</p>

<hr>

<% }) %>

</div>

<h3>
💰 Fees & Payments
</h3>


<div class="dashboard-card">


<% child.invoices.forEach(invoice => { %>


<p>

<strong>
🧾 <%= invoice.invoice_number %>
</strong>

<br>


<%= invoice.description %>


<br>

Amount:

R<%= invoice.amount %>


<br>

Paid:

R<%= invoice.amount_paid %>


<br>

Balance:

R<%= invoice.balance %>


<br>

Status:

<%= invoice.status %>


</p>


<hr>


<% }) %>


</div>

<h3>💬 Teacher Feedback</h3>

<div class="dashboard-card">

<% if(child.feedback.length){ %>

<% child.feedback.forEach(item => { %>

<p>

<%= item.feedback %>

<br>

<small>

<%= item.created_at %>

</small>

</p>

<hr>

<% }) %>

<% } else { %>

<p>No feedback available.</p>

<% } %>

</div>

<h3>📚 Enrolled Courses</h3>

<div class="dashboard-card">

<% if(child.courses.length){ %>

<ul>

<% child.courses.forEach(course => { %>

<li>

<%= course.title %>

</li>

<% }) %>

</ul>

<% } else { %>

<p>No courses enrolled.</p>

<% } %>

</div>

<% }) %>

</div>



</main>


</body>

</html>