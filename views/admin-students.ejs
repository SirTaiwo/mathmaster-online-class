<!DOCTYPE html>
<html>

<head>

<title>Manage Students</title>

<link
rel="stylesheet"
href="/css/style.css"
>

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>

<div class="nav-links">

<a href="/admin/dashboard">
Dashboard
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>



<main class="dashboard">


<h1>
Student Management
</h1>


<% if (success) { %>

<div class="success">
<%= success %>
</div>

<% } %>


<% if (error) { %>

<div class="error">
<%= error %>
</div>

<% } %>

<div class="auth-card">

<h2>
Create Student Account
</h2>


<form
action="/admin/students/create"
method="POST"
>


<label>
First Name
</label>

<input
type="text"
name="first_name"
required
>


<label>
Last Name
</label>

<input
type="text"
name="last_name"
required
>


<label>
Email
</label>

<input
type="email"
name="email"
required
>


<label>
Grade
</label>

<input
type="text"
name="grade"
placeholder="Example: Grade 10"
required
>


<label>
Temporary Password
</label>

<input
type="password"
name="password"
minlength="6"
required
>


<button
class="btn primary"
type="submit"
>
Create Student
</button>


</form>

</div>

<div class="auth-card">


<table class="users-table">


<thead>

<tr>

<th>Name</th>

<th>Email</th>

<th>Grade</th>

<th>Actions</th>

</tr>

</thead>


<tbody>


<% students.forEach(function(student){ %>


<tr>

<td>
<%= student.first_name %>
<%= student.last_name %>
</td>


<td>
<%= student.email %>
</td>


<td>
<%= student.grade || "Not assigned" %>
</td>


<td>

<a href="/admin/students/edit/<%= student.id %>">
Edit
</a>

|

<a 
href="/admin/students/delete/<%= student.id %>"
onclick="return confirm('Delete this student?')">
Delete
</a>

</td>


</tr>


<% }) %>


</tbody>


</table>


</div>


</main>


</body>

</html>