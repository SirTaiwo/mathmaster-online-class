<!DOCTYPE html>

<html>

<head>

    <title>Edit Question</title>

</head>

<body>

<h1>Edit Assessment Question</h1>

<form
method="POST"
action="/teacher/questions/<%= question.id %>/edit">

<p>

Question

</p>

<textarea
name="question"
rows="4"
cols="70"><%= question.question %></textarea>

<br><br>

<label>

A

</label>

<input
type="text"
name="option_a"
value="<%= question.option_a %>">

<br><br>

<label>

B

</label>

<input
type="text"
name="option_b"
value="<%= question.option_b %>">

<br><br>

<label>

C

</label>

<input
type="text"
name="option_c"
value="<%= question.option_c %>">

<br><br>

<label>

D

</label>

<input
type="text"
name="option_d"
value="<%= question.option_d %>">

<br><br>

<label>

Correct Answer

</label>

<select
name="correct_answer">

<option
value="A"
<%= question.correct_answer === "A" ? "selected" : "" %>>

A

</option>

<option
value="B"
<%= question.correct_answer === "B" ? "selected" : "" %>>

B

</option>

<option
value="C"
<%= question.correct_answer === "C" ? "selected" : "" %>>

C

</option>

<option
value="D"
<%= question.correct_answer === "D" ? "selected" : "" %>>

D

</option>

</select>

<br><br>

<label>

Marks

</label>

<input
type="number"
name="marks"
value="<%= question.marks %>">

<br><br>

<button
type="submit">

Update Question

</button>

</form>

</body>

</html>