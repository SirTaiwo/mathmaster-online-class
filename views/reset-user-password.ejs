<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>Reset User Password - MathMaster</title>

<link
    rel="stylesheet"
    href="/css/style.css"
>

</head>


<body>


<header>

<nav class="navbar">

<div class="logo">
Math<span>Master</span>
</div>


<div class="nav-links">

<a href="/admin/users">
Back to Users
</a>

<a href="/logout">
Logout
</a>

</div>

</nav>

</header>


<main class="dashboard">


<div class="dashboard-header">

<p class="eyebrow">
ADMINISTRATION
</p>

<h1>
Reset User Password
</h1>

<p>
Set a new password for this user.
</p>

</div>


<div class="auth-card">


<h2>
<%= member.first_name %>
<%= member.last_name %>
</h2>


<p>
<strong>Email:</strong>
<%= member.email %>
</p>


<p>
<strong>Role:</strong>
<%= member.role %>
</p>


<% if (error) { %>

<div class="error">
<%= error %>
</div>

<% } %>


<form
    method="POST"
    action="/admin/users/reset-password/<%= member.id %>"
>


<label>
New Password
</label>

<input
    type="password"
    name="password"
    minlength="6"
    required
    autocomplete="new-password"
>


<label>
Confirm New Password
</label>

<input
    type="password"
    name="confirm_password"
    minlength="6"
    required
    autocomplete="new-password"
>


<p>
Password must be at least 6 characters.
</p>


<button
    type="submit"
    class="btn primary"
>
Reset Password
</button>


<a
    href="/admin/users"
    class="btn"
>
Cancel
</a>


</form>


</div>


</main>


</body>

</html>
